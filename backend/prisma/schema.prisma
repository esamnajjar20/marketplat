generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x", "linux-arm64-openssl-1.1.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String               @id @default(cuid())
  name                      String
  email                     String               @unique
  phone                     String?              @unique
  passwordHash              String
  role                      Role                 @default(USER)
  city                      String?
  bio                       String?
  avatarUrl                 String?
  isActive                  Boolean              @default(true)
  notificationPreferences   Json                 @default("{\"adViews\": false, \"newMessage\": true, \"promotions\": false, \"favAdUpdated\": true}")
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
  ads                       Ad[]
  auditLogs                 AuditLog[]
  favorites                 Favorite[]
  passwordResetTokens       PasswordResetToken[]
  reports                   Report[]
  sellerProfile             SellerProfile?
  sellerRatingsGiven        SellerRating[]
  serviceRequestsAsCustomer ServiceRequest[]     @relation("ServiceRequestsAsCustomer")
  serviceReviewsGiven       ServiceReview[]      @relation("ServiceReviewsGiven")
  conversationsAsBuyer      Conversation[]       @relation("ConversationsAsBuyer")
  conversationsAsSeller     Conversation[]       @relation("ConversationsAsSeller")
  messagesSent              Message[]            @relation("MessagesSent")
  notifications             Notification[]

  @@index([isActive, createdAt])
  @@map("users")
}

model Category {
  id        String     @id @default(cuid())
  name      String     @unique
  nameAr    String     @unique
  slug      String     @unique
  parentId  String?
  createdAt DateTime   @default(now())
  ads       Ad[]
  parent    Category?  @relation("CategoryParent", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryParent")

  @@index([parentId])
  @@map("categories")
}

model Ad {
  id              String         @id @default(cuid())
  title           String
  description     String
  price           Decimal?       @db.Decimal(10, 2)
  images          String[]
  city            String
  condition       AdCondition?
  isNegotiable    Boolean        @default(false)
  status          AdStatus       @default(ACTIVE)
  views           Int            @default(0)
  isFeatured      Boolean        @default(false)
  isPinned        Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  userId          String
  categoryId      String?
  sellerProfileId String?
  category        Category?      @relation(fields: [categoryId], references: [id])
  sellerProfile   SellerProfile? @relation(fields: [sellerProfileId], references: [id])
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  favorites       Favorite[]
  reports         Report[]
  ratings         SellerRating[]
  conversations   Conversation[]

  @@index([userId])
  @@index([categoryId])
  @@index([sellerProfileId])
  @@index([status, userId, createdAt])
  @@index([status, createdAt])
  @@index([status, city])
  @@index([userId, status])
  @@index([isFeatured, isPinned])
  @@map("ads")
}

model Favorite {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String
  adId      String
  ad        Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, adId])
  @@index([userId])
  @@map("favorites")
}

model Report {
  id        String       @id @default(cuid())
  reason    ReportReason
  notes     String?      @db.VarChar(500)
  status    ReportStatus @default(PENDING)
  createdAt DateTime     @default(now())
  adId      String
  userId    String
  ad        Ad           @relation(fields: [adId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([adId, userId])
  @@index([status])
  @@map("reports")
}

model SellerProfile {
  id                     String                   @id @default(cuid())
  userId                 String                   @unique
  displayName            String
  bio                    String?
  avatarUrl              String?
  verified               Boolean                  @default(false)
  verificationStatus     SellerVerificationStatus @default(UNVERIFIED)
  verifiedAt             DateTime?
  suspended              Boolean                  @default(false)
  suspendedAt            DateTime?
  trustScore             Int                      @default(0)
  averageRating          Decimal                  @default(0) @db.Decimal(3, 2)
  totalRatings           Int                      @default(0)
  totalAds               Int                      @default(0)
  activeAds              Int                      @default(0)
  totalSales             Int                      @default(0)
  responseRate           Decimal?                 @db.Decimal(5, 2)
  responseTimeMinutes    Int?
  joinedSellingAt        DateTime                 @default(now())
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  ads                    Ad[]
  user                   User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ratings                SellerRating[]
  serviceProviderDetails ServiceProviderDetails?
  serviceReviews         ServiceReview[]

  @@index([verified, trustScore])
  @@index([trustScore])
  @@map("seller_profiles")
}

model SellerRating {
  id              String        @id @default(cuid())
  score           Int
  comment         String?       @db.VarChar(500)
  sellerProfileId String
  raterId         String
  adId            String?
  createdAt       DateTime      @default(now())
  ad              Ad?           @relation(fields: [adId], references: [id])
  rater           User          @relation(fields: [raterId], references: [id], onDelete: Cascade)
  sellerProfile   SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)

  @@unique([sellerProfileId, raterId, adId])
  @@index([sellerProfileId])
  @@map("seller_ratings")
}

model ServiceProviderDetails {
  id                     String              @id @default(cuid())
  sellerProfileId        String              @unique
  businessName           String
  businessType           ServiceBusinessType @default(INDIVIDUAL)
  logoUrl                String?
  description            String              @db.VarChar(1000)
  serviceAreaCities      String[]
  workingHours           Json
  contactPhone           String
  availabilityStatus     ServiceAvailability @default(AVAILABLE)
  latitude               Decimal?            @db.Decimal(9, 6)
  longitude              Decimal?            @db.Decimal(9, 6)
  completedRequestsCount Int                 @default(0)
  fulfillmentRate        Decimal?            @db.Decimal(5, 2)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  appointments           Appointment[]
  listings               ServiceListing[]
  sellerProfile          SellerProfile       @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)

  @@index([availabilityStatus])
  @@index([latitude, longitude])
  @@map("service_provider_details")
}

model ServiceCategory {
  id        String            @id @default(cuid())
  name      String            @unique
  nameAr    String            @unique
  slug      String            @unique
  icon      String?
  parentId  String?
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())
  parent    ServiceCategory?  @relation("ServiceCategoryParent", fields: [parentId], references: [id])
  children  ServiceCategory[] @relation("ServiceCategoryParent")
  listings  ServiceListing[]

  @@index([parentId])
  @@map("service_categories")
}

model ServiceListing {
  id               String                 @id @default(cuid())
  providerId       String
  categoryId       String
  title            String
  description      String                 @db.VarChar(2000)
  images           String[]
  pricingType      ServicePricingType     @default(NEGOTIABLE)
  price            Decimal?               @db.Decimal(10, 2)
  durationEstimate String?
  serviceLocation  ServiceLocationType    @default(AT_PROVIDER)
  status           ServiceListingStatus   @default(ACTIVE)
  views            Int                    @default(0)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  category         ServiceCategory        @relation(fields: [categoryId], references: [id])
  provider         ServiceProviderDetails @relation(fields: [providerId], references: [id], onDelete: Cascade)
  requests         ServiceRequest[]

  @@index([categoryId, status])
  @@index([providerId, status])
  @@index([status, createdAt])
  @@map("service_listings")
}

model ServiceRequest {
  id             String               @id @default(cuid())
  listingId      String
  customerId     String
  status         ServiceRequestStatus @default(PENDING)
  details        String               @db.VarChar(1000)
  attachedImages String[]
  quotedPrice    Decimal?             @db.Decimal(10, 2)
  agreedPrice    Decimal?             @db.Decimal(10, 2)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  respondedAt    DateTime?
  appointment    Appointment?
  customer       User                 @relation("ServiceRequestsAsCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  listing        ServiceListing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  review         ServiceReview?

  @@index([listingId, status])
  @@index([customerId])
  @@index([status, createdAt])
  @@map("service_requests")
}

model Appointment {
  id             String                 @id @default(cuid())
  providerId     String
  requestId      String?                @unique
  scheduledStart DateTime
  scheduledEnd   DateTime
  status         AppointmentStatus      @default(SCHEDULED)
  notes          String?                @db.VarChar(500)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  provider       ServiceProviderDetails @relation(fields: [providerId], references: [id], onDelete: Cascade)
  request        ServiceRequest?        @relation(fields: [requestId], references: [id])

  @@index([providerId, scheduledStart, scheduledEnd])
  @@map("appointments")
}

model ServiceReview {
  id              String         @id @default(cuid())
  score           Int
  comment         String?        @db.VarChar(500)
  requestId       String         @unique
  raterId         String
  sellerProfileId String
  createdAt       DateTime       @default(now())
  rater           User           @relation("ServiceReviewsGiven", fields: [raterId], references: [id], onDelete: Cascade)
  request         ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  sellerProfile   SellerProfile  @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)

  @@index([sellerProfileId])
  @@map("service_reviews")
}

// Messaging (Epic 5): a Conversation always starts from an Ad (the
// disabled "مراسلة البائع" button in SellerCard.tsx is the only entry
// point in the current UI), but adId is nullable so the thread survives
// the ad being deleted/sold later — same "outlives its origin" shape as
// ServiceRequest.appointment, just the reverse direction (Conversation
// doesn't disappear if the Ad does; onDelete: SetNull, not Cascade).
//
// The @@unique([adId, buyerId, sellerId]) constraint prevents duplicate
// threads for the same (ad, buyer, seller) triple — re-clicking "مراسلة
// البائع" on an ad you already messaged about reopens the same
// Conversation instead of creating a new one. Postgres treats each NULL
// in a unique index as distinct, so this does NOT also collapse two
// *different* ad-less conversations between the same pair into one row —
// every ad-qualified thread is still deduplicated correctly, which is
// the actual goal; a second ad-less thread between the same two users
// is a follow-up decision, not this migration's concern.
model Conversation {
  id        String    @id @default(cuid())
  adId      String?
  buyerId   String
  sellerId  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  ad        Ad?       @relation(fields: [adId], references: [id], onDelete: SetNull)
  buyer     User      @relation("ConversationsAsBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  seller    User      @relation("ConversationsAsSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@unique([adId, buyerId, sellerId])
  @@index([buyerId, updatedAt])
  @@index([sellerId, updatedAt])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  body           String       @db.VarChar(2000)
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("MessagesSent", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

// Epic 6 (Notification Center): a general-purpose in-app notification —
// NOT push (see PushNotificationToggle.tsx's own doc comment: that's a
// separate, still-unwired subsystem requiring VAPID keys + a service
// worker + its own endpoint). This is the bell/dropdown inside the app.
//
// Of the four NotificationType values, only NEW_MESSAGE and
// FAV_AD_PRICE_CHANGED are actually generated anywhere right now
// (conversations.service.ts's sendMessage, and ads.service.ts's
// updateAd on a price change to a favorited ad). PROMOTION is generated
// only through the admin broadcast endpoint (POST /admin/notifications/
// broadcast) — never automatically. WEEKLY_AD_VIEWS_REPORT has NO
// generator at all yet: it's a batch job ("تقرير أسبوعي بمشاهدات
// إعلاناتك" in NotificationSettingsForm.tsx) and this codebase has no
// cron/scheduler infrastructure to run one. The enum value and the
// notificationPreferences.adViews toggle both exist so the UI's four
// settings map onto four real types, but nothing currently writes a
// WEEKLY_AD_VIEWS_REPORT row — that's future work, not a bug here.
enum NotificationType {
  NEW_MESSAGE
  FAV_AD_PRICE_CHANGED
  PROMOTION
  WEEKLY_AD_VIEWS_REPORT
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String           @db.VarChar(500)
  // Free-form per-type payload the frontend uses to deep-link — e.g.
  // { conversationId } for NEW_MESSAGE, { adId } for
  // FAV_AD_PRICE_CHANGED. Same "flexible Json, not a dozen nullable
  // columns" shape as AuditLog.details.
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

model AuditLog {
  id        String         @id @default(cuid())
  event     AuditEventType
  userId    String?
  sessionId String?
  ip        String?
  userAgent String?
  details   Json?
  createdAt DateTime       @default(now())
  user      User?          @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([event])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

enum Role {
  USER
  ADMIN
}

enum AdStatus {
  ACTIVE
  SOLD
  DELETED
}

enum AdCondition {
  NEW
  USED
  REFURBISHED
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

enum ReportReason {
  SCAM
  FAKE
  OFFENSIVE
  SPAM
}

enum SellerVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum ServiceBusinessType {
  INDIVIDUAL
  SMALL_BUSINESS
}

enum ServiceAvailability {
  AVAILABLE
  BUSY
  UNAVAILABLE
}

enum ServicePricingType {
  FIXED
  STARTING_FROM
  NEGOTIABLE
}

enum ServiceListingStatus {
  ACTIVE
  PAUSED
  DELETED
}

enum ServiceLocationType {
  AT_CUSTOMER
  AT_PROVIDER
  REMOTE
}

enum ServiceRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AuditEventType {
  REGISTER
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  LOGOUT_ALL
  TOKEN_REFRESHED
  TOKEN_REUSE_DETECTED
  SESSION_REVOKED
  ACCOUNT_LOCKED
  PASSWORD_CHANGED
  ROLE_CHANGED
  ACCOUNT_DISABLED
  ADMIN_AD_FEATURED
  ADMIN_AD_PINNED
  ADMIN_AD_DELETED
  ADMIN_USER_STATUS_CHANGED
  ADMIN_SELLER_VERIFIED
  ADMIN_SELLER_SUSPENDED
}
