generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x", "linux-arm64-openssl-1.1.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String               @id @default(cuid())
  name                      String
  email                     String               @unique
  phone                     String?              @unique
  passwordHash              String
  role                      Role                 @default(USER)
  city                      String?
  bio                       String?
  avatarUrl                 String?
  isActive                  Boolean              @default(true)
  notificationPreferences   Json                 @default("{\"adViews\": false, \"newMessage\": true, \"promotions\": false, \"favAdUpdated\": true}")
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
  ads                       Ad[]
  auditLogs                 AuditLog[]
  favorites                 Favorite[]
  passwordResetTokens       PasswordResetToken[]
  reports                   Report[]
  sellerProfile             SellerProfile?
  sellerRatingsGiven        SellerRating[]
  serviceRequestsAsCustomer ServiceRequest[]     @relation("ServiceRequestsAsCustomer")
  serviceReviewsGiven       ServiceReview[]      @relation("ServiceReviewsGiven")

  @@index([isActive, createdAt])
  @@map("users")
}

model Category {
  id        String     @id @default(cuid())
  name      String     @unique
  nameAr    String     @unique
  slug      String     @unique
  parentId  String?
  createdAt DateTime   @default(now())
  ads       Ad[]
  parent    Category?  @relation("CategoryParent", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryParent")

  @@index([parentId])
  @@map("categories")
}

model Ad {
  id              String         @id @default(cuid())
  title           String
  description     String
  price           Decimal?       @db.Decimal(10, 2)
  images          String[]
  city            String
  condition       AdCondition?
  isNegotiable    Boolean        @default(false)
  status          AdStatus       @default(ACTIVE)
  views           Int            @default(0)
  isFeatured      Boolean        @default(false)
  isPinned        Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  userId          String
  categoryId      String?
  sellerProfileId String?
  category        Category?      @relation(fields: [categoryId], references: [id])
  sellerProfile   SellerProfile? @relation(fields: [sellerProfileId], references: [id])
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  favorites       Favorite[]
  reports         Report[]
  ratings         SellerRating[]

  @@index([userId])
  @@index([categoryId])
  @@index([sellerProfileId])
  @@index([status, userId, createdAt])
  @@index([status, createdAt])
  @@index([status, city])
  @@index([userId, status])
  @@index([isFeatured, isPinned])
  @@map("ads")
}

model Favorite {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String
  adId      String
  ad        Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, adId])
  @@index([userId])
  @@map("favorites")
}

model Report {
  id        String       @id @default(cuid())
  reason    ReportReason
  notes     String?      @db.VarChar(500)
  status    ReportStatus @default(PENDING)
  createdAt DateTime     @default(now())
  adId      String
  userId    String
  ad        Ad           @relation(fields: [adId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([adId, userId])
  @@index([status])
  @@map("reports")
}

model SellerProfile {
  id                     String                   @id @default(cuid())
  userId                 String                   @unique
  displayName            String
  bio                    String?
  avatarUrl              String?
  verified               Boolean                  @default(false)
  verificationStatus     SellerVerificationStatus @default(UNVERIFIED)
  verifiedAt             DateTime?
  suspended              Boolean                  @default(false)
  suspendedAt            DateTime?
  trustScore             Int                      @default(0)
  averageRating          Decimal                  @default(0) @db.Decimal(3, 2)
  totalRatings           Int                      @default(0)
  totalAds               Int                      @default(0)
  activeAds              Int                      @default(0)
  totalSales             Int                      @default(0)
  responseRate           Decimal?                 @db.Decimal(5, 2)
  responseTimeMinutes    Int?
  joinedSellingAt        DateTime                 @default(now())
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  ads                    Ad[]
  user                   User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ratings                SellerRating[]
  serviceProviderDetails ServiceProviderDetails?
  serviceReviews         ServiceReview[]

  @@index([verified, trustScore])
  @@index([trustScore])
  @@map("seller_profiles")
}

model SellerRating {
  id              String        @id @default(cuid())
  score           Int
  comment         String?       @db.VarChar(500)
  sellerProfileId String
  raterId         String
  adId            String?
  createdAt       DateTime      @default(now())
  ad              Ad?           @relation(fields: [adId], references: [id])
  rater           User          @relation(fields: [raterId], references: [id], onDelete: Cascade)
  sellerProfile   SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)

  @@unique([sellerProfileId, raterId, adId])
  @@index([sellerProfileId])
  @@map("seller_ratings")
}

model ServiceProviderDetails {
  id                     String              @id @default(cuid())
  sellerProfileId        String              @unique
  businessName           String
  businessType           ServiceBusinessType @default(INDIVIDUAL)
  logoUrl                String?
  description            String              @db.VarChar(1000)
  serviceAreaCities      String[]
  workingHours           Json
  contactPhone           String
  availabilityStatus     ServiceAvailability @default(AVAILABLE)
  latitude               Decimal?            @db.Decimal(9, 6)
  longitude              Decimal?            @db.Decimal(9, 6)
  completedRequestsCount Int                 @default(0)
  fulfillmentRate        Decimal?            @db.Decimal(5, 2)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  appointments           Appointment[]
  listings               ServiceListing[]
  sellerProfile          SellerProfile       @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)

  @@index([availabilityStatus])
  @@index([latitude, longitude])
  @@map("service_provider_details")
}

model ServiceCategory {
  id        String            @id @default(cuid())
  name      String            @unique
  nameAr    String            @unique
  slug      String            @unique
  icon      String?
  parentId  String?
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())
  parent    ServiceCategory?  @relation("ServiceCategoryParent", fields: [parentId], references: [id])
  children  ServiceCategory[] @relation("ServiceCategoryParent")
  listings  ServiceListing[]

  @@index([parentId])
  @@map("service_categories")
}

model ServiceListing {
  id               String                 @id @default(cuid())
  providerId       String
  categoryId       String
  title            String
  description      String                 @db.VarChar(2000)
  images           String[]
  pricingType      ServicePricingType     @default(NEGOTIABLE)
  price            Decimal?               @db.Decimal(10, 2)
  durationEstimate String?
  serviceLocation  ServiceLocationType    @default(AT_PROVIDER)
  status           ServiceListingStatus   @default(ACTIVE)
  views            Int                    @default(0)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  category         ServiceCategory        @relation(fields: [categoryId], references: [id])
  provider         ServiceProviderDetails @relation(fields: [providerId], references: [id], onDelete: Cascade)
  requests         ServiceRequest[]

  @@index([categoryId, status])
  @@index([providerId, status])
  @@index([status, createdAt])
  @@map("service_listings")
}

model ServiceRequest {
  id             String               @id @default(cuid())
  listingId      String
  customerId     String
  status         ServiceRequestStatus @default(PENDING)
  details        String               @db.VarChar(1000)
  attachedImages String[]
  quotedPrice    Decimal?             @db.Decimal(10, 2)
  agreedPrice    Decimal?             @db.Decimal(10, 2)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  respondedAt    DateTime?
  appointment    Appointment?
  customer       User                 @relation("ServiceRequestsAsCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  listing        ServiceListing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  review         ServiceReview?

  @@index([listingId, status])
  @@index([customerId])
  @@index([status, createdAt])
  @@map("service_requests")
}

model Appointment {
  id             String                 @id @default(cuid())
  providerId     String
  requestId      String?                @unique
  scheduledStart DateTime
  scheduledEnd   DateTime
  status         AppointmentStatus      @default(SCHEDULED)
  notes          String?                @db.VarChar(500)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  provider       ServiceProviderDetails @relation(fields: [providerId], references: [id], onDelete: Cascade)
  request        ServiceRequest?        @relation(fields: [requestId], references: [id])

  @@index([providerId, scheduledStart, scheduledEnd])
  @@map("appointments")
}

model ServiceReview {
  id              String         @id @default(cuid())
  score           Int
  comment         String?        @db.VarChar(500)
  requestId       String         @unique
  raterId         String
  sellerProfileId String
  createdAt       DateTime       @default(now())
  rater           User           @relation("ServiceReviewsGiven", fields: [raterId], references: [id], onDelete: Cascade)
  request         ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  sellerProfile   SellerProfile  @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)

  @@index([sellerProfileId])
  @@map("service_reviews")
}

model AuditLog {
  id        String         @id @default(cuid())
  event     AuditEventType
  userId    String?
  sessionId String?
  ip        String?
  userAgent String?
  details   Json?
  createdAt DateTime       @default(now())
  user      User?          @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([event])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

enum Role {
  USER
  ADMIN
}

enum AdStatus {
  ACTIVE
  SOLD
  DELETED
}

enum AdCondition {
  NEW
  USED
  REFURBISHED
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

enum ReportReason {
  SCAM
  FAKE
  OFFENSIVE
  SPAM
}

enum SellerVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum ServiceBusinessType {
  INDIVIDUAL
  SMALL_BUSINESS
}

enum ServiceAvailability {
  AVAILABLE
  BUSY
  UNAVAILABLE
}

enum ServicePricingType {
  FIXED
  STARTING_FROM
  NEGOTIABLE
}

enum ServiceListingStatus {
  ACTIVE
  PAUSED
  DELETED
}

enum ServiceLocationType {
  AT_CUSTOMER
  AT_PROVIDER
  REMOTE
}

enum ServiceRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AuditEventType {
  REGISTER
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  LOGOUT_ALL
  TOKEN_REFRESHED
  TOKEN_REUSE_DETECTED
  SESSION_REVOKED
  ACCOUNT_LOCKED
  PASSWORD_CHANGED
  ROLE_CHANGED
  ACCOUNT_DISABLED
  ADMIN_AD_FEATURED
  ADMIN_AD_PINNED
  ADMIN_AD_DELETED
  ADMIN_USER_STATUS_CHANGED
  ADMIN_SELLER_VERIFIED
  ADMIN_SELLER_SUSPENDED
}
