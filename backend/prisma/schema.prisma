// Fraud-detection (item 12). Each value maps to one concrete heuristic
// in fraudService — kept as narrow/enumerable as AnalyticsEventType's
// own "map to one concrete question" convention, not a free-text field,
// so admin filtering/aggregation stays possible.
enum FraudSignalType {
  // Same user creating an abnormal number of ads within a short
  // rolling window (see env.fraud.rapidPostingWindowSeconds/MaxPosts).
  RAPID_POSTING
  // Price is a statistical outlier vs. the category's recent median —
  // both far below (classic "too good to be true" scam bait) and far
  // above are flagged; fraudService records which direction in metadata.
  SUSPICIOUS_PRICE
  // Description/title contains a URL, a phone number outside the
  // normal contact flow, or another off-platform-contact pattern —
  // common precursor to steering a buyer off-platform before scamming
  // them.
  SUSPICIOUS_CONTACT_PATTERN
  // Title/description matches known scam-keyword patterns (wire
  // transfer only, "send deposit first", gift-card payment, etc.).
  SUSPICIOUS_KEYWORDS
  // This exact title+price+city (or a near-duplicate) already exists
  // as another active ad from the same user — classic listing-spam
  // pattern distinct from RAPID_POSTING's pure velocity check.
  DUPLICATE_LISTING
  // Account is very new (see env.fraud.newAccountWindowHours) and is
  // already exhibiting another signal — new-ness alone isn't
  // suspicious, but it raises the weight of everything else.
  NEW_ACCOUNT_HIGH_ACTIVITY
  // Manually raised by an admin outside the automated scoring path
  // (e.g. from a pattern noticed while reviewing Reports) — lets a
  // human-observed pattern live in the same signal/queue system as
  // automated ones instead of a separate ad-hoc mechanism.
  MANUAL_ADMIN_FLAG
}

