generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x", "linux-arm64-openssl-1.1.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")

  directUrl = env("DIRECT_URL")
}

model SavedSearch {
  id             String    @id @default(cuid())
  userId         String
  label          String
  // Search filters, same shape as GET /ads's query params (q/city/
  // categoryId/condition/minPrice/maxPrice) — stored as-is rather than
  // as separate columns so this stays in lockstep with getAdsSchema
  // without a migration every time a new filter is added. Matching
  // logic (savedSearches.service.ts) reads known keys back out of this
  // JSON defensively.
  filters        Json
  createdAt      DateTime  @default(now())
  // Bumped every time this search matches a newly created ad, so a
  // user isn't re-notified for the exact same ad if matching logic
  // ever runs more than once for it (defensive; matching currently only
  // runs once, at ad-creation time).
  lastNotifiedAt DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("saved_searches")
}

// Gap #10 ("نشاطي" / My Activity): a personal, reverse-chronological
// timeline of a single user's own actions across the whole platform
// (ads, products, service listings, stores, favorites, messages,
// service requests, appointments, account changes).
//
// Deliberately a NEW table rather than reusing AuditLog or
// AnalyticsEvent — both already exist in this schema but serve
// different readers:
//   - AuditLog is security/admin-facing (login, role change, password
//     change) and is never read back by the acting user themselves.
//   - AnalyticsEvent is aggregate/product-analytics-facing (funnels,
//     category popularity) — high-volume, written for anonymous
//     traffic too, and queried in rollups, not as one user's list.
// UserActivity is the third, distinct shape: always tied to a real
// user (no anonymous rows), always read as "my own list, newest
// first, optionally filtered by type" — a query pattern neither
// existing table indexes for cheaply. See activity.service.ts's
// record() for the single write path every module calls through.
model UserActivity {
  id          String              @id @default(cuid())
  userId      String
  type        UserActivityType
  // Pre-rendered Arabic title/description at write time (e.g. "تم نشر
  // إعلان جديد" / ad.title) rather than re-derived at read time from
  // entityId — keeps the timeline readable even after the referenced
  // ad/product/listing is later deleted, and avoids an N+1 join back
  // into 6+ different tables (ads/products/serviceListings/stores/
  // conversations/serviceRequests) just to render a list.
  title       String
  description String?
  // What this activity links to, if anything (MESSAGE_SENT and
  // PROFILE_UPDATED/PASSWORD_CHANGED have none). entityType is a plain
  // string tag ('AD' | 'PRODUCT' | 'SERVICE_LISTING' | 'STORE' |
  // 'CONVERSATION' | 'SERVICE_REQUEST' | 'APPOINTMENT'), not a Prisma
  // relation — same deliberate non-FK reasoning as AnalyticsEvent
  // above: the referenced row can be hard- or soft-deleted later
  // without needing cascade/orphan handling on this table, since a
  // timeline entry should keep existing (and its title/description
  // still render) even after the thing it pointed to is gone.
  entityType  ActivityEntityType?
  entityId    String?
  // Free-form extra context a specific activity type wants to carry
  // (e.g. old/new status for SERVICE_REQUEST_STATUS_CHANGED) without
  // needing a schema change per type — same convention as
  // AuditLog.details / AnalyticsEvent.metadata.
  metadata    Json?
  // T452 — idempotency key for buffered writes. activityBuffer.ts
  // pushes serialized entries onto a Redis list, then drains them to
  // Postgres via createMany() on a timer. If the createMany commits
  // but the response is lost before the buffer's LPOP+INSERT atomically
  // confirms (a network blip between this process and Neon, a container
  // restart mid-flush), the retry path re-pushes the same serialized
  // entries — which would insert duplicates without this column. With
  // it, the createMany call uses skipDuplicates:true and the retry
  // becomes a no-op. Key is generated once in push() (randomUUID),
  // carried through the Redis round-trip, and stable across re-pushes
  // (see activityBuffer.ts's own doc comment for the exact shape).
  // Nullable so pre-existing rows (from before this migration) are
  // unaffected — Postgres treats multiple NULLs as non-conflicting in
  // a unique index.
  idempotencyKey String?          @unique
  createdAt   DateTime            @default(now())
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Powers the two real query shapes activity.repository.ts runs:
  // "my timeline, newest first" and "my timeline filtered to one type,
  // newest first". No separate [userId, createdAt]-only index is
  // needed alongside it — Postgres can use a composite index's leading
  // column(s) alone, so [userId, type, createdAt] already serves an
  // unfiltered query on just [userId, createdAt] too.
  @@index([userId, type, createdAt])
  @@map("user_activities")
}

model User {
  id                          String                    @id @default(cuid())
  name                        String
  email                       String                    @unique
  phone                       String?                   @unique
  // FIX OAUTH-01: nullable now — a user created via Google OAuth (see
  // modules/auth/google.strategy.ts) never sets a local password and
  // has nothing to hash. authService.login() now additionally guards
  // on passwordHash being present before comparing (an OAuth-only
  // account has none to compare against).
  passwordHash                String?
  // FIX FEAT-EMAIL-VERIFY: true once the user has clicked the link in
  // the verification email. New local registrations default to false;
  // Google-signup users are created with true (Google already verified
  // their address). Pre-existing users were backfilled to true by the
  // 20260921120000_add_email_verification migration. Gating rules live
  // in middlewares/requireVerifiedEmail.middleware.ts.
  emailVerified               Boolean                   @default(false)
  emailVerifiedAt             DateTime?
  // FIX OAUTH-01: which identity provider created this account.
  // 'local' (default) = registered via email/password. 'google' = the
  // account either originated from Google Sign-In or had a Google
  // identity linked to an existing local account (see
  // google.strategy.ts's link-by-email path).
  provider                    String                    @default("local")
  // FIX OAUTH-01: the stable Google account identifier (OIDC `sub` /
  // Google profile `id`). Optional + unique — null for every
  // local-only user; Prisma/Postgres treat multiple NULLs in a unique
  // column as non-conflicting, so this never collides across local
  // accounts.
  googleId                    String?                   @unique
  role                        Role                      @default(USER)
  city                        String?
  // FEAT-GOOGLE-COMPLETE-PROFILE: true only for a brand-new account
  // created via Google Sign-In (authRepository.createWithGoogle) —
  // Google never supplies a city, and we ask the user to pick one
  // (and confirm their name) on a dedicated /complete-profile step
  // right after their first Google sign-up, instead of leaving city
  // silently null. Defaults to false for every local registration
  // (RegisterForm already collects city there, even though it's
  // optional) and for existing/linked Google accounts (authService.
  // loginWithGoogle's Case 1/2), so this never re-interrupts a
  // returning user. Cleared to false the moment PATCH /users/me is
  // called with a city (usersService.updateMe) — the completion form
  // uses that exact endpoint, so no separate "complete" endpoint was
  // needed.
  needsProfileCompletion      Boolean                   @default(false)
  bio                         String?
  avatarUrl                   String?
  isActive                    Boolean                   @default(true)
  notificationPreferences     Json                      @default("{\"adViews\": false, \"newMessage\": true, \"promotions\": false, \"favAdUpdated\": true}")
  createdAt                   DateTime                  @default(now())
  updatedAt                   DateTime                  @updatedAt
  ads                         Ad[]
  auditLogs                   AuditLog[]
  conversationsAsBuyer        Conversation[]            @relation("ConversationsAsBuyer")
  conversationsAsSeller       Conversation[]            @relation("ConversationsAsSeller")
  favorites                   Favorite[]
  messagesSent                Message[]                 @relation("MessagesSent")
  notifications               Notification[]
  pushSubscriptions           PushSubscription[]
  fcmDeviceTokens              FcmDeviceToken[]
  passwordResetTokens         PasswordResetToken[]
  emailVerificationTokens     EmailVerificationToken[]
  reports                     Report[]
  sellerProfile               SellerProfile?
  sellerRatingsGiven          SellerRating[]
  savedSearches               SavedSearch[]
  serviceRequestsAsCustomer   ServiceRequest[]          @relation("ServiceRequestsAsCustomer")
  serviceReviewsGiven         ServiceReview[]           @relation("ServiceReviewsGiven")
  // Open marketplace requests (PRODUCT/SERVICE/RENTAL) — separate from
  // ServiceRequest (directed to a listing).
  requestsAsCustomer          Request[]                 @relation("RequestsAsCustomer")
  requestOffersMade           RequestOffer[]            @relation("RequestOffersAsOfferer")
  storeFollows                StoreFollower[]
  storeReviewsGiven           StoreReview[]             @relation("StoreReviewsGiven")
  blocksMade                  UserBlock[]               @relation("BlocksMade")
  blocksReceived              UserBlock[]               @relation("BlocksReceived")
  activities                  UserActivity[]
  fraudSignals                FraudSignal[]

  storeMemberships   StoreMember[]  @relation("StoreMemberships")
  storeMemberInvites StoreMember[]  @relation("StoreMemberInvites")
  FavoriteList       FavoriteList[]

  @@index([isActive, createdAt])
  @@map("users")
}

model Category {
  id        String     @id @default(cuid())
  name      String     @unique
  nameAr    String     @unique
  slug      String     @unique
  parentId  String?
  createdAt DateTime   @default(now())
  ads       Ad[]
  parent    Category?  @relation("CategoryParent", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryParent")

  @@index([parentId])
  @@map("categories")
}

model Ad {
  id                String         @id @default(cuid())
  title             String
  description       String
  price             Decimal?       @db.Decimal(10, 2)
  images            String[]
  city              String
  // TRACK-NEARBY-SEARCH: optional precise pin, same shape/precision as
  // StoreDetails.latitude/longitude and ServiceProviderDetails's own
  // pair — city (above) stays the required/primary location signal for
  // every ad; these two are opt-in and only populated when the seller
  // shares a precise location, enabling GET /search's lat/lng-based
  // nearby sort/filter (search.repository.ts) the same way
  // ServiceProviderDetails already enables GET /service-providers/nearby.
  latitude          Decimal?       @db.Decimal(9, 6)
  longitude         Decimal?       @db.Decimal(9, 6)
  condition         AdCondition?
  isNegotiable      Boolean        @default(false)
  status            AdStatus       @default(ACTIVE)
  views             Int            @default(0)
  // Snapshot of `views` at the moment the last WEEKLY_AD_VIEWS_REPORT
  // notification was generated for this ad's owner. The weekly report
  // job (src/scripts/weeklyAdViewsReport.ts) needs a *delta* ("+42
  // views this week"), but `views` itself is a lifetime cumulative
  // counter with no history — this column is that missing baseline.
  // Every run reads (views - viewsAtLastReport) then writes the new
  // views value back here, so the next run's delta starts clean.
  // Nullable/defaulted to 0 so existing ads before this migration are
  // treated as "everything so far is new" on their first report.
  viewsAtLastReport Int            @default(0)
  isFeatured        Boolean        @default(false)
  isPinned          Boolean        @default(false)
  pinnedByAdmin     Boolean        @default(false)
  // Fraud-detection (item 12): 0-100 heuristic score computed at
  // creation/update time by fraudService.scoreAd (see
  // modules/fraud/fraud.service.ts). Not a Prisma relation target
  // itself — the individual signals that produced this number are
  // recorded separately in FraudSignal so the score stays explainable
  // (an admin reviewing a flagged ad can see *why*, not just the
  // number) and so re-scoring logic can evolve without needing to
  // migrate historical rows.
  riskScore         Int            @default(0)
  // True once riskScore crosses env.fraud.autoFlagThreshold (or a
  // manual admin flag). Indexed on its own below because the admin
  // fraud queue's primary query is "give me every flagged ad",
  // independent of status/city/etc — the same reasoning as
  // isFeatured/isPinned already getting their own composite index.
  flaggedForReview  Boolean        @default(false)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  userId            String
  categoryId        String?
  sellerProfileId   String?
  // Optional store as the *visible* publisher. userId remains the
  // owner for permissions/audit. null = personal ad; set = store ad.
  storeId           String?
  // FIX OFFLINE-IDEMPOTENCY-01: client-generated X-Offline-Op-Id from
  // the SW offline queue. Unique when present so a replayed POST after
  // a flaky network ACK returns the existing row instead of a duplicate ad.
  offlineOperationId String?       @unique
  category          Category?      @relation(fields: [categoryId], references: [id])
  sellerProfile     SellerProfile? @relation(fields: [sellerProfileId], references: [id])
  store             StoreDetails?  @relation(fields: [storeId], references: [id], onDelete: SetNull)
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations     Conversation[]
  reports           Report[]
  ratings           SellerRating[]
  fraudSignals      FraudSignal[]

  @@index([userId])
  @@index([categoryId])
  @@index([sellerProfileId])
  @@index([storeId])
  @@index([storeId, status, createdAt])
  @@index([status, userId, createdAt])
  @@index([status, createdAt])
  @@index([status, city])
  @@index([userId, status])
  @@index([isFeatured, isPinned])
  @@index([flaggedForReview, createdAt])
  // TRACK-NEARBY-SEARCH: same composite-index rationale as
  // ServiceProviderDetails's own @@index([latitude, longitude]) — lets
  // the bounding-box pre-filter in search.repository.ts's nearby branch
  // hit an index instead of computing Haversine over every row.
  @@index([latitude, longitude])
  @@map("ads")
}

// FEAT-FAVORITE-POLYMORPHIC PR1: Favorite is being generalized from an
// AD-only FK relation to the same entityType+entityId, no-FK shape
// UserActivity/Report already established (see Report's own comment
// above for the precedent and rationale — a favorited entity must keep
// rendering in "My Favorites" logic even if it's later hard-deleted,
// and Prisma has no cross-model polymorphic relation type).
//
// PR1 scope is AD only end-to-end (favorites.service.ts/.controller.ts
// still only expose /favorites/:adId routes) — entityType/entityId
// exist now so the schema and backfill are done once, but PRODUCT/
// STORE/SERVICE_LISTING values are not yet written or read anywhere.
// See PR2 for enabling those.
//
// adId is kept, nullable, as a legacy compatibility column — NOT the
// source of truth after backfill (entityType/entityId is). It exists
// solely so a fast rollback to the pre-PR1 schema/code is possible
// without re-deriving data. A follow-up migration drops it once PR1
// has been live and verified.
enum FavoriteEntityType {
  AD
  PRODUCT
  SERVICE_LISTING
  STORE
}

model Favorite {
  id         String             @id @default(cuid())
  createdAt  DateTime           @default(now())
  userId     String
  entityType FavoriteEntityType
  entityId   String
  // Legacy compatibility column — see model doc comment above. No
  // @relation: an FK here would defeat the point (can't point one
  // column at 4 different tables), and the AD relation this used to
  // carry is now resolved manually by favorites.repository.ts via
  // entityType/entityId, same pattern as UserActivity's own entityId.
  adId       String?
  listId     String?
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  list       FavoriteList?      @relation(fields: [listId], references: [id], onDelete: SetNull)

  @@unique([userId, entityType, entityId])
  @@index([userId])
  @@index([entityType, entityId])
  @@map("favorites")
}

model FavoriteList {
  id        String   @id @default(cuid())
  userId    String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  favorites Favorite[]

  @@unique([userId, name])
  @@index([userId, sortOrder])
  @@map("favorite_lists")
}

// FEAT-REPORT-USER-STORE: Report used to be AD-only (a required adId FK
// straight to Ad, @@unique([adId, userId])). That made it structurally
// impossible to report a user's profile or a store — there was no column
// to point at them. Converted to the same polymorphic shape UserActivity
// already established (targetType enum + targetId plain string, no FK):
// deliberately NOT a relation, since a reported user/store/ad can be
// deleted later and the report row must keep rendering in the admin
// queue (reason/notes/status) even after the target is gone — same
// reasoning as ActivityEntityType's doc comment above.
// adId is kept as a nullable column (not dropped) so existing report rows
// don't lose their ad reference; the migration backfills targetType=AD,
// targetId=adId for every pre-existing row, so no data is lost.
model Report {
  id         String           @id @default(cuid())
  reason     ReportReason
  notes      String?          @db.VarChar(500)
  status     ReportStatus     @default(PENDING)
  createdAt  DateTime         @default(now())
  targetType ReportTargetType
  targetId   String
  userId     String
  // Legacy FK, retained only for the AD case so existing includes/joins
  // that expect ad.title etc. keep working without a query-time branch.
  // Nullable because USER/STORE reports have no Ad row at all.
  adId       String?
  ad         Ad?              @relation(fields: [adId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([targetType, targetId, userId])
  @@index([status])
  @@index([targetType, targetId])
  @@map("reports")
}

// Fraud-detection (item 12 — "نظام مكافحة الاحتيال"). Append-only log
// of individual heuristic signals fraudService.scoreAd/scoreUser emit,
// distinct from AuditLog (security/admin actions) and Report
// (user-submitted complaints) — this is *system-generated* suspicion,
// never something a user files themselves. One row per signal firing
// (not one row per ad), so an ad that trips both RAPID_POSTING and
// SUSPICIOUS_PRICE gets two rows — same "explainable, not just a
// number" reasoning as the doc comment on Ad.riskScore.
model FraudSignal {
  id         String          @id @default(cuid())
  type       FraudSignalType
  // Points this single signal contributed toward the subject's
  // riskScore at the time it fired. Kept alongside `type` (rather than
  // only in fraudRules.ts config) so a signal's historical weight is
  // preserved even if the rule's weight is retuned later — an admin
  // reviewing an old flag sees the score that actually drove the flag,
  // not today's (possibly different) weight for that rule.
  weight     Int
  // Free-form context for the admin review UI — e.g. { postsInWindow: 12,
  // windowSeconds: 60 } for RAPID_POSTING, { price: 1, medianPrice: 450 }
  // for SUSPICIOUS_PRICE. Same "shape varies by type, consumer
  // switches on type first" convention as AuditLog.details.
  metadata   Json?
  // Exactly one of userId/adId is the primary subject depending on
  // `type` (account-level signals like RAPID_POSTING key off userId;
  // content-level signals like SUSPICIOUS_PRICE/SUSPICIOUS_LINK key off
  // adId), but both are stored whenever known so an admin looking at
  // either the user's or the ad's history sees the full picture — same
  // dual-key convenience as Ad already carrying both userId and
  // sellerProfileId rather than forcing a join.
  userId     String?
  adId       String?
  reviewed   Boolean         @default(false)
  reviewedAt DateTime?
  reviewedBy String?
  createdAt  DateTime        @default(now())
  user       User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  ad         Ad?             @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([adId, createdAt])
  @@index([type, createdAt])
  @@index([reviewed, createdAt])
  @@map("fraud_signals")
}

// Self-referential: a blocker prevents a blocked user from messaging
// them. Directional (A blocking B does not imply B blocking A) — same
// shape as StoreFollower's (userId, storeId) pair, just both sides
// pointing at User instead of one side pointing at StoreDetails. Two
// named relations on User (BlocksMade / BlocksReceived) exactly mirror
// how Conversation already disambiguates ConversationsAsBuyer /
// ConversationsAsSeller for its own two User FKs.
model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  // AUDIT-FIX 1.6: existsEitherDirection (blocked-users.repository.ts)
  // queries `OR: [{blockerId:A, blockedId:B}, {blockerId:B, blockedId:A}]`.
  // The @@unique([blockerId, blockedId]) above covers the first branch
  // perfectly; the plain @@index([blockedId]) alone is not an equally
  // tight match for the second branch (blockerId=B AND blockedId=A is
  // a two-column lookup, not a single-column one) and degrades toward a
  // partial/full scan as the table grows. This composite index gives
  // the second OR branch the same index-only lookup the first already
  // has, in the argument order that branch actually needs.
  @@index([blockedId, blockerId])
  @@map("user_blocks")
}

model SellerProfile {
  id                     String                   @id @default(cuid())
  userId                 String                   @unique
  displayName            String
  bio                    String?
  avatarUrl              String?
  verified               Boolean                  @default(false)
  verificationStatus     SellerVerificationStatus @default(UNVERIFIED)
  verifiedAt             DateTime?
  suspended              Boolean                  @default(false)
  suspendedAt            DateTime?
  trustScore             Int                      @default(0)
  averageRating          Decimal                  @default(0) @db.Decimal(3, 2)
  totalRatings           Int                      @default(0)
  totalAds               Int                      @default(0)
  activeAds              Int                      @default(0)
  totalSales             Int                      @default(0)
  responseRate           Decimal?                 @db.Decimal(5, 2)
  responseTimeMinutes    Int?
  joinedSellingAt        DateTime                 @default(now())
  paymentMethods         Json?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  ads                    Ad[]
  user                   User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ratings                SellerRating[]
  serviceProviderDetails ServiceProviderDetails?
  serviceReviews         ServiceReview[]
  storeDetails           StoreDetails?
  storeReviews           StoreReview[]

  @@index([verified, trustScore])
  @@index([trustScore])
  @@map("seller_profiles")
}

model SellerRating {
  id              String        @id @default(cuid())
  score           Int
  comment         String?       @db.VarChar(500)
  sellerProfileId String
  raterId         String
  adId            String?
  createdAt       DateTime      @default(now())
  ad              Ad?           @relation(fields: [adId], references: [id])
  rater           User          @relation(fields: [raterId], references: [id], onDelete: Cascade)
  sellerProfile   SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)

  @@unique([sellerProfileId, raterId, adId])
  @@index([sellerProfileId])
  @@map("seller_ratings")
}

model ServiceProviderDetails {
  id                     String              @id @default(cuid())
  sellerProfileId        String              @unique
  businessName           String
  businessType           ServiceBusinessType @default(INDIVIDUAL)
  logoUrl                String?
  description            String              @db.VarChar(1000)
  serviceAreaCities      String[]
  workingHours           Json
  contactPhone           String
  // UNIFY-PAYMENTS: removed — a ServiceProviderDetails row always hangs
  // off a SellerProfile (sellerProfileId is @unique above), so payment
  // methods now live only on SellerProfile.paymentMethods and are read
  // through the sellerProfile relation. Having two separate arrays that
  // had to be merged/deduped for display (see PublicProfileHeader's old
  // pushAll logic) was the exact duplicated-state problem this removes.
  availabilityStatus     ServiceAvailability @default(AVAILABLE)
  latitude               Decimal?            @db.Decimal(9, 6)
  longitude              Decimal?            @db.Decimal(9, 6)
  completedRequestsCount Int                 @default(0)
  fulfillmentRate        Decimal?            @db.Decimal(5, 2)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  appointments           Appointment[]
  listings               ServiceListing[]
  sellerProfile          SellerProfile       @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)

  @@index([availabilityStatus])
  @@index([latitude, longitude])
  // GIN index on serviceAreaCities (array containment for the `city`
  // filter in GET /service-providers) is added via raw SQL migration
  // 20260817000000_add_service_provider_city_index — not expressible
  // here without the extendedIndexes preview feature. See that
  // migration's comment and the Notification.data comment above for
  // the same precedent.
  @@map("service_provider_details")
}

model ServiceCategory {
  id         String                    @id @default(cuid())
  name       String                    @unique
  nameAr     String                    @unique
  slug       String                    @unique
  icon       String?
  parentId   String?
  isActive   Boolean                   @default(true)
  createdAt  DateTime                  @default(now())
  parent     ServiceCategory?          @relation("ServiceCategoryParent", fields: [parentId], references: [id])
  children   ServiceCategory[]         @relation("ServiceCategoryParent")
  listings   ServiceListing[]

  @@index([parentId])
  @@map("service_categories")
}

model ServiceListing {
  id                String                 @id @default(cuid())
  providerId        String
  categoryId        String
  title             String
  description       String                 @db.VarChar(2000)
  images            String[]
  pricingType       ServicePricingType     @default(NEGOTIABLE)
  price             Decimal?               @db.Decimal(10, 2)
  durationEstimate  String?
  serviceLocation   ServiceLocationType    @default(AT_PROVIDER)
  status            ServiceListingStatus   @default(ACTIVE)
  views             Int                    @default(0)
  // FIX OFFLINE-IDEMPOTENCY-01
  offlineOperationId String?               @unique
  /// Baseline for weekly provider views report deltas.
  viewsAtLastReport Int                    @default(0)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  category          ServiceCategory        @relation(fields: [categoryId], references: [id])
  provider          ServiceProviderDetails @relation(fields: [providerId], references: [id], onDelete: Cascade)
  requests          ServiceRequest[]

  @@index([categoryId, status])
  @@index([providerId, status])
  @@index([status, createdAt])
  @@map("service_listings")
}

model ServiceRequest {
  id             String               @id @default(cuid())
  listingId      String
  customerId     String
  status         ServiceRequestStatus @default(PENDING)
  details        String               @db.VarChar(1000)
  attachedImages String[]
  quotedPrice    Decimal?             @db.Decimal(10, 2)
  agreedPrice    Decimal?             @db.Decimal(10, 2)
  // FIX OFFLINE-IDEMPOTENCY-01
  offlineOperationId String?          @unique
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  respondedAt    DateTime?
  appointment    Appointment?
  conversation   Conversation?
  customer       User                 @relation("ServiceRequestsAsCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  listing        ServiceListing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  review         ServiceReview?

  @@index([listingId, status])
  @@index([customerId])
  @@index([status, createdAt])
  @@map("service_requests")
}

model Appointment {
  id             String                 @id @default(cuid())
  providerId     String
  requestId      String?                @unique
  scheduledStart DateTime
  scheduledEnd   DateTime
  status         AppointmentStatus      @default(SCHEDULED)
  notes          String?                @db.VarChar(500)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  provider       ServiceProviderDetails @relation(fields: [providerId], references: [id], onDelete: Cascade)
  request        ServiceRequest?        @relation(fields: [requestId], references: [id])

  @@index([providerId, scheduledStart, scheduledEnd])
  @@map("appointments")
}

model ServiceReview {
  id              String         @id @default(cuid())
  score           Int
  comment         String?        @db.VarChar(500)
  requestId       String         @unique
  raterId         String
  sellerProfileId String
  createdAt       DateTime       @default(now())
  rater           User           @relation("ServiceReviewsGiven", fields: [raterId], references: [id], onDelete: Cascade)
  request         ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  sellerProfile   SellerProfile  @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)

  @@index([sellerProfileId])
  @@map("service_reviews")
}

// ---------------------------------------------------------------------
// Service Request Marketplace: the "🔥" feature from the services
// feature audit — a customer describes a need once (not tied to any
// single provider's listing, unlike ServiceRequest above) and any
// number of providers competing in that category/city can each submit
// a price quote. The customer compares and accepts exactly one.
// Deliberately a separate model from ServiceRequest rather than
// bolting a nullable listingId onto it: ServiceRequest's whole status
// machine (PENDING->ACCEPTED->IN_PROGRESS->COMPLETED, reviews,
// provider stats) assumes a single fixed provider from the start,
// which is the opposite of this feature's "many providers compete"
// premise. Once a quote is accepted, the two parties coordinate the
// rest (scheduling, the actual job) via the Conversation this creates
// — see service-broadcasts.service.ts's acceptQuote — rather than
// this model growing its own duplicate booking/appointment machinery.
// ---------------------------------------------------------------------
// =============================================================================
// Open Requests marketplace (option B) — does NOT replace ServiceRequest
// (directed to a listing). Phase 1 types: SERVICE | PRODUCT | RENTAL.
// Offerer is always User (offererUserId); no offererRole column.
// budgetMin/budgetMax optional. Accept path must use a transaction with
// conditional update on status=OPEN.
// =============================================================================

enum RequestType {
  SERVICE
  PRODUCT
  RENTAL
}

enum RequestStatus {
  OPEN
  ACCEPTED
  CANCELLED
  EXPIRED
}

enum RequestOfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
}

model Request {
  id              String        @id @default(cuid())
  customerId      String
  type            RequestType
  /// Category id from the tree that matches `type` (service / product / ad).
  /// Not a Prisma FK on purpose — different category tables per type;
  /// the service layer validates existence and type alignment.
  categoryId      String
  title           String
  description     String        @db.VarChar(1000)
  city            String?
  attachedImages  String[]
  budgetMin       Decimal?      @db.Decimal(12, 2)
  budgetMax       Decimal?      @db.Decimal(12, 2)
  /// Type-specific payload (e.g. condition, bedrooms) — Zod validates by type.
  attributes      Json?
  status          RequestStatus @default(OPEN)
  acceptedOfferId String?       @unique
  expiresAt       DateTime?
  // FIX OFFLINE-IDEMPOTENCY-01
  offlineOperationId String?    @unique
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  customer        User          @relation("RequestsAsCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  offers          RequestOffer[] @relation("RequestOffers")
  acceptedOffer   RequestOffer?  @relation("AcceptedRequestOffer", fields: [acceptedOfferId], references: [id])

  @@index([type, status, createdAt])
  @@index([categoryId, status, createdAt])
  @@index([customerId])
  @@index([status, expiresAt])
  @@map("requests")
}

model RequestOffer {
  id            String             @id @default(cuid())
  requestId     String
  /// Offering user — role/eligibility enforced in the service layer, not here.
  offererUserId String
  price         Decimal            @db.Decimal(12, 2)
  message       String?            @db.VarChar(1000)
  /// Optional extras (durationEstimate, linkedAdId, linkedProductId, …).
  meta          Json?
  status        RequestOfferStatus @default(PENDING)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  request       Request            @relation("RequestOffers", fields: [requestId], references: [id], onDelete: Cascade)
  offerer       User               @relation("RequestOffersAsOfferer", fields: [offererUserId], references: [id], onDelete: Cascade)
  acceptedFor   Request?           @relation("AcceptedRequestOffer")

  @@unique([requestId, offererUserId])
  @@index([offererUserId, status])
  @@index([requestId, status])
  @@map("request_offers")
}

// ---------------------------------------------------------------------
// Stores module: local shops, built on top of an existing SellerProfile
// — same "extension" relationship ServiceProviderDetails already has,
// not a standalone User→Store link. A seller can hold a StoreDetails
// and/or ServiceProviderDetails at once; both share the same
// verification/suspension/trust-score gate on SellerProfile.
// ---------------------------------------------------------------------
model StoreType {
  id               String            @id
  slug             String            @unique
  nameAr           String
  icon             String
  labels           Json
  freeProductLimit Int?
  isActive         Boolean           @default(true)
  sortOrder        Int               @default(0)
  stores           StoreDetails[]
  productCategories ProductCategory[]

  @@index([isActive, sortOrder])
  @@map("store_types")
}

model StoreDetails {
  id                 String            @id @default(cuid())
  sellerProfileId    String            @unique
  storeTypeId        String            @default("st_general")
  name               String
  // STORE-SLUG (Foundation v1): URL-safe, shareable identifier —
  // /stores/:idOrSlug resolves this before falling back to the cuid
  // `id`. Generated once at createStore time from `name` (see
  // shared/utils/slugify.ts) and left immutable on rename, same
  // reasoning as most marketplaces keep slugs stable so a shared link
  // never 404s just because the owner edited their store name.
  slug               String            @unique
  description        String            @db.VarChar(1000)
  logoUrl            String?
  coverImageUrl      String?
  city               String
  address            String?
  phone              String
  status             StoreStatus       @default(PENDING)
  plan               StorePlan         @default(FREE)
  latitude           Decimal?          @db.Decimal(9, 6)
  longitude          Decimal?          @db.Decimal(9, 6)
  // STORE-HOURS (Foundation v1): same { sun: {open,close}|null, ... }
  // shape as ServiceProviderDetails.workingHours — copied deliberately
  // so both modules share one mental model and (later) one frontend
  // component. Optional: a store with no hours set just never renders
  // an open/closed badge (storesService.computeIsOpen returns null).
  workingHours       Json?
  // UNIFY-PAYMENTS-STORES: removed — a StoreDetails row always hangs
  // off a SellerProfile (sellerProfileId is @unique above), so payment
  // methods now live only on SellerProfile.paymentMethods and are read
  // through the sellerProfile relation. Same exact duplicated-state
  // problem, and same fix, as ServiceProviderDetails.paymentMethods'
  // removal (see that field's comment / the UNIFY-PAYMENTS migration).
  // STORE-VIEWS (Foundation v1): lifetime counter, same convention as
  // Product.views — bumped fire-and-forget from getPublicStore, not
  // from the AnalyticsEvent pipeline (that table has no storeId column
  // today; adding one is a separate, bigger migration).
  views              Int               @default(0)
  viewsAtLastReport  Int               @default(0)
  featureRequestedAt DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  sellerProfile      SellerProfile     @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)
  storeType          StoreType          @relation(fields: [storeTypeId], references: [id])
  products           Product[]
  promotions         Promotion[]
  followers          StoreFollower[]
  collections        StoreCollection[]
  members            StoreMember[]
  ads                Ad[]

  @@index([status, city])
  @@index([status, plan])
  @@index([storeTypeId])
  @@map("store_details")
}

model StoreMember {
  id          String            @id @default(cuid())
  storeId     String
  userId      String
  role        StoreMemberRole
  status      StoreMemberStatus @default(PENDING)
  invitedById String
  invitedAt   DateTime          @default(now())
  acceptedAt  DateTime?
  removedAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  store     StoreDetails @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user      User         @relation("StoreMemberships", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User         @relation("StoreMemberInvites", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([storeId, status])
  @@index([userId, status])
  @@map("store_members")
}

model ProductCategory {
  id        String            @id @default(cuid())
  name      String            @unique
  nameAr    String            @unique
  slug      String            @unique
  icon      String?
  parentId  String?
  storeTypeId String?
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())
  parent    ProductCategory?  @relation("ProductCategoryParent", fields: [parentId], references: [id])
  children  ProductCategory[] @relation("ProductCategoryParent")
  storeType  StoreType?        @relation(fields: [storeTypeId], references: [id])
  products  Product[]

  @@index([parentId])
  @@index([storeTypeId])
  @@map("product_categories")
}

model Product {
  id              String                   @id @default(cuid())
  storeId         String
  categoryId      String
  name            String
  description     String                   @db.VarChar(2000)
  images          String[]
  price           Decimal                  @db.Decimal(10, 2)
  wholesalePrice  Decimal?                 @db.Decimal(10, 2)
  wholesaleMinQty Int?
  discountPrice   Decimal?                 @db.Decimal(10, 2)
  availability    ProductAvailability      @default(IN_STOCK)
  stockQuantity   Int?
  status          ProductStatus            @default(ACTIVE)
  views           Int                      @default(0)
  // FIX OFFLINE-IDEMPOTENCY-01: same as Ad.offlineOperationId
  offlineOperationId String?               @unique
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  store           StoreDetails             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category        ProductCategory          @relation(fields: [categoryId], references: [id])
  promotions      Promotion[]
  collections     StoreCollectionProduct[]

  @@index([storeId, status])
  @@index([categoryId, status])
  @@index([status, createdAt])
  @@map("products")
}

// PROMO-1: scheduled/time-boxed discount on a single Product, decoupled
// from Product.discountPrice (the older, still-supported static
// override — see products.service.ts's getEffectivePrice for how the
// two are reconciled: an ACTIVE-and-in-window Promotion always wins;
// discountPrice is the fallback for products that never adopt
// Promotion). Deliberately NOT linked to Ad here — Phase 13 of the
// original design doc wires Ad -> Promotion later via a separate
// optional Ad.promotionId, keeping "what's for sale / what's discounted
// / what's advertised" as three independent concerns.
model Promotion {
  id             String          @id @default(cuid())
  storeId        String
  productId      String
  title          String
  description    String?         @db.VarChar(500)
  discountType   DiscountType
  discountValue  Decimal         @db.Decimal(10, 2)
  startsAt       DateTime
  endsAt         DateTime
  status         PromotionStatus @default(SCHEDULED)
  maxUses        Int?
  usageCount     Int             @default(0)
  // PROMO-1 (Phase 14): set the moment myPromotionsExpiring.ts sends
  // the "about to expire" notification for this row — the idempotency
  // guard so a promotion still within the warning window on the next
  // run isn't re-notified every single run. Mirrors Ad's
  // viewsAtLastReport baseline-column pattern (see
  // weeklyAdViewsReport.ts) rather than a boolean flag, so re-running
  // the script never re-sends for a row already warned, but a
  // DIFFERENT promotion on the same product later still gets its own
  // warning independently.
  expiryWarnedAt DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  store          StoreDetails    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([storeId, status])
  @@index([productId, startsAt, endsAt])
  @@map("promotions")
}

// COLLECTIONS (P1): lets a store owner group products into named
// shelves ("Phones", "Best Sellers") that a product can belong to
// more than one of — many-to-many via StoreCollectionProduct below,
// same reasoning the design doc gave for rejecting a single
// collectionId column on Product. slug is scoped to the store
// (@@unique([storeId, slug]), not global) since /stores/:store/
// collections/:slug is always read within one store's URL, unlike
// StoreDetails.slug which must be globally unique on its own.
model StoreCollection {
  id          String                   @id @default(cuid())
  storeId     String
  name        String
  slug        String
  description String?                  @db.VarChar(500)
  imageUrl    String?
  // Owner-controlled manual ordering for the storefront's collection
  // list (not createdAt) — mirrors ProductCategory.sortOrder.
  sortOrder   Int                      @default(0)
  // Lets an owner hide a collection (e.g. a seasonal one) without
  // losing its product memberships, same convention as
  // StoreDetails.status for the whole store.
  isActive    Boolean                  @default(true)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  store       StoreDetails             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products    StoreCollectionProduct[]

  @@unique([storeId, slug])
  @@index([storeId, isActive, sortOrder])
  @@map("store_collections")
}

// Join table for the Collection <-> Product many-to-many. A composite
// PK (rather than a surrogate id + separate @@unique) since the row
// has no identity of its own beyond "this product is in this
// collection" — mirrors how StoreFollower keys off (storeId,
// followerId) for the same reason.
model StoreCollectionProduct {
  collectionId String
  productId    String
  // Owner-controlled position within THIS collection specifically —
  // deliberately separate from Product's own createdAt/global
  // ordering, since the same product can sit at position 1 in
  // "Best Sellers" and position 8 in "Phones" simultaneously.
  sortOrder    Int             @default(0)
  addedAt      DateTime        @default(now())
  collection   StoreCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product         @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@index([productId])
  @@index([collectionId, sortOrder])
  @@map("store_collection_products")
}

model StoreFollower {
  id        String       @id @default(cuid())
  userId    String
  storeId   String
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  store     StoreDetails @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
  @@index([storeId])
  @@map("store_followers")
}

model StoreReview {
  id              String        @id @default(cuid())
  score           Int
  comment         String?       @db.VarChar(500)
  sellerProfileId String
  raterId         String
  createdAt       DateTime      @default(now())
  rater           User          @relation("StoreReviewsGiven", fields: [raterId], references: [id], onDelete: Cascade)
  sellerProfile   SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)

  // One review per (user, store) — same shape as SellerRating's
  // per-rater uniqueness, simpler than ServiceReview's per-request
  // uniqueness since a store review isn't tied to a single transaction
  // record the way a completed ServiceRequest is.
  @@unique([sellerProfileId, raterId])
  @@index([sellerProfileId])
  @@map("store_reviews")
}

model Conversation {
  id               String          @id @default(cuid())
  // FEAT-CONV-DEDUP: adId is initial-context only — which ad/listing
  // the thread happened to start from — and is deliberately NOT part
  // of the identity key below anymore. See @@unique([buyerId, sellerId]).
  adId             String?
  // CHAT-LINK: lets a service request's own detail page offer a
  // "تواصل" entry point into a real thread instead of only a phone
  // number, same as an ad already does via adId. Still its own
  // @unique (a ServiceRequest has exactly one customer and one
  // provider, so at most one thread can legitimately be "for" it) but
  // no longer part of the conversation's identity key either — see
  // @@unique([buyerId, sellerId]) below, which is now the sole
  // identity for a thread between two users.
  serviceRequestId String?         @unique
  buyerId          String
  sellerId         String
  // MSG-FEAT: pin/archive — pinned threads float to top; archived hidden from default list
  pinnedAt         DateTime?
  archivedAt       DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  ad               Ad?             @relation(fields: [adId], references: [id])
  serviceRequest   ServiceRequest? @relation(fields: [serviceRequestId], references: [id], onDelete: SetNull)
  buyer            User            @relation("ConversationsAsBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  seller           User            @relation("ConversationsAsSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  messages         Message[]

  // FEAT-CONV-DEDUP: was @@unique([adId, buyerId, sellerId]) — that let
  // the same two users accumulate a separate conversation per ad. The
  // conversation's identity is now the (buyerId, sellerId) pair alone:
  // one thread per pair of users, regardless of which ad/product/
  // service/service-request it started from. Enforced at the DB level
  // (not just an application-level findFirst) so concurrent requests
  // can't create two rows for the same pair — see
  // conversations.repository.ts's create() for the P2002-then-refetch
  // handling this requires.
  @@unique([buyerId, sellerId])
  @@index([buyerId, updatedAt])
  @@index([sellerId, updatedAt])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  body           String       @db.VarChar(2000)
  // MSG-FEAT: optional image attachment (Cloudinary URL)
  imageUrl       String?
  readAt         DateTime?
  // Soft-delete: set by the sender via DELETE /conversations/:id/messages/:messageId.
  // The row is kept (not physically removed) so the other party's thread
  // still shows a "تم حذف هذه الرسالة" placeholder in place, rather than a
  // gap that could read as a missing/broken message — same reasoning as
  // Ad's own soft states elsewhere in this schema. `body` itself is left
  // untouched on delete (not blanked) so a future admin/audit read path
  // isn't blocked by this decision; every read-facing repository method
  // is responsible for not leaking `body` once `deletedAt` is set.
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("MessagesSent", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  // FIX UX-15: powers the per-conversation unreadCount added to
  // findManyForUser (conversations.repository.ts) — that query filters
  // on conversationId + senderId + readAt together (unread = readAt
  // IS NULL, sent by the other party), which [conversationId,
  // createdAt] above doesn't cover.
  @@index([conversationId, senderId, readAt])
  @@map("messages")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String           @db.VarChar(500)
  // AUDIT-FIX 1.11 (reviewed, no index added): `data` carries small
  // per-type payloads (adId, conversationId, storeId, savedSearchId —
  // see notifications.service.ts's notificationEvents for every shape
  // written here). Checked every read path on this model
  // (notifications.repository.ts) before deciding: none of
  // findManyForUser/countUnreadForUser ever filter on `data` — every
  // query here is scoped by userId/readAt/createdAt only, all already
  // covered by the two indexes below. A GIN index on `data` would add
  // write overhead (every insert/createMany touches it) with zero
  // current read benefit. If a future feature needs "find my
  // notifications about ad X" or similar, add a targeted index
  // (`@@index` on a GIN expression, or promote the specific key to its
  // own column if it becomes a primary lookup path) at that point —
  // not preemptively for a query that doesn't exist yet.
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

// FIX PWA-PUSH-01: persists the browser PushSubscription objects created
// by frontend/lib/pwa.ts's subscribeToPush() — previously nothing on the
// backend received or stored these (see notifications.service.ts's
// notificationEvents for the in-app notification rows this feeds
// alongside; a push send is the "also ring the browser" counterpart to
// each of those, not a replacement for them).
//
// One row per (user, device/browser) — a user can be subscribed on
// several devices at once, each with its own endpoint. `endpoint` is
// globally unique (it's a full URL issued by the browser's push
// service, e.g. FCM or Mozilla's autopush) rather than unique per-user,
// which is what makes it safe to use as the natural key for upserts:
// re-subscribing the same browser (e.g. after clearing the permission
// and re-granting it) sends the same endpoint again and should update
// the existing row rather than create a duplicate.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique @db.VarChar(1000)
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  // Device list (Phase 2 UX): `label` is the user-visible name — defaulted
  // from the User-Agent on first registration, then owned by the user
  // (re-registration never overwrites it). `lastSeenAt` is bumped each time
  // the client re-registers the endpoint (app open / login sync).
  label      String?  @db.VarChar(60)
  lastSeenAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Every send fans out to "every subscription row for this user" —
  // this is the only lookup pushService.ts's notifyUser needs.
  @@index([userId])
  @@map("push_subscriptions")
}

// NEW — device tokens for native push (Capacitor + Firebase Cloud
// Messaging), the Android/iOS-app counterpart to PushSubscription
// above (which is Web Push / VAPID, browser-only). See
// backend/src/shared/utils/fcmPushService.ts's header for why
// standard Web Push isn't reused for the native app instead of adding
// a second table. Same upsert-on-natural-key shape as
// PushSubscription: `token` is FCM's own opaque device token, unique
// per installation, so re-registering the same device (app reopen,
// token refresh) updates the existing row rather than duplicating it.
model FcmDeviceToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique @db.VarChar(500)
  platform  String   @db.VarChar(20) // 'android' | 'ios'
  createdAt DateTime @default(now())
  // See PushSubscription.label / lastSeenAt.
  label      String?  @db.VarChar(60)
  lastSeenAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("fcm_device_tokens")
}

model AuditLog {
  id        String         @id @default(cuid())
  event     AuditEventType
  userId    String?
  sessionId String?
  ip        String?
  userAgent String?
  details   Json?
  createdAt DateTime       @default(now())
  user      User?          @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([event])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

// Product-analytics event log — distinct from AuditLog, which tracks
// security/admin actions (login, role changes). This tracks product
// usage (page views, searches, ad views, contact clicks) for both
// anonymous visitors and logged-in users, feeding the admin analytics
// dashboard (funnel, category popularity, search→contact conversion).
//
// Deliberately NOT a Prisma relation to User (no `user User? @relation`,
// just a plain nullable id): this table will grow far faster than any
// other in the schema (every page view/search is a row), and tying it
// to User via a real FK would (a) force a decision on cascade behavior
// at user-deletion time for a table that's expected to be pruned/
// rolled up on its own retention schedule rather than deleted alongside
// a user, and (b) add relation-load weight to the User model for a
// table nothing else ever needs to join through Prisma — reads here
// always start from AnalyticsEvent, not from User.
model AnalyticsEvent {
  id        String             @id @default(cuid())
  event     AnalyticsEventType
  // Null for anonymous visitors. Deliberately not a foreign key — see
  // model-level comment above.
  userId    String?
  // Groups events from the same browser session without requiring
  // login — generated client-side (crypto.randomUUID(), persisted in
  // sessionStorage-equivalent) so a single visit's page views/searches
  // can be strung into a funnel even for anonymous traffic.
  sessionId String
  // Free-form event payload: adId for AD_VIEW, query text for SEARCH,
  // categoryId for CATEGORY_BROWSE, step name for SIGNUP_STEP, etc.
  // Shape intentionally varies by `event` — consumers switch on `event`
  // before reading known keys out of this, same convention as
  // AuditLog.details.
  metadata  Json?
  path      String?
  referrer  String?
  createdAt DateTime           @default(now())

  // createdAt alone covers "events in the last N days" scans; the
  // composite covers "trend for event X over time" without a second
  // index — both are the two query shapes the admin summary endpoint
  // actually runs.
  @@index([createdAt])
  @@index([event, createdAt])
  @@index([sessionId])
  @@index([userId])
  // PR5C: recommendations.repository.ts's recentlyViewedCategoryIds
  // (AD/PRODUCT/SERVICE_LISTING) all run the same shape —
  // WHERE "userId" = ? AND "event" = ? AND "createdAt" >= ?
  // ORDER BY "createdAt" DESC LIMIT 200
  // — filtering on all three columns together. The existing
  // [userId] and [event, createdAt] indexes each cover only part of
  // that predicate; neither lets Postgres narrow to this one user's
  // rows of this one event type directly. See migration
  // 20260826000000_add_analytics_event_recommendation_index for the
  // actual composite index (column order userId, event, createdAt —
  // matches the three WHERE equality/range predicates left-to-right,
  // with createdAt last so its DESC ordering also serves the
  // ORDER BY/LIMIT for free once the first two columns narrow the
  // scan).
  @@index([userId, event, createdAt])
  // FIX M-021: analytics.repository.ts's topCategories() groups by
  // metadata->>'categoryId', which no index here covered — see
  // migration 20260809000000_add_analytics_category_index for the
  // actual expression index (`@@index` can't express a JSON path
  // expression in this Prisma version, so it's applied via raw SQL in
  // that migration and only documented here for discoverability).
  @@map("analytics_events")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// FIX FEAT-EMAIL-VERIFY: mirror of PasswordResetToken for the email
// verification flow. Kept as a separate table (not a `type` column on
// the reset table) so the two flows can evolve independently and so
// `used=false` cleanup queries stay trivially scoped. 24h TTL applies
// at the service layer, not the DB. Cascade delete on user.
model EmailVerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

// FIX M-011 / M-012: this app has no message queue (BullMQ or
// otherwise) — fire-and-forget side effects (notifications, fraud
// scoring, ...) that fail transiently just log an error and vanish,
// with no trace that anything needs a retry or a human look. Since
// introducing a full queue is a larger architectural change than a
// bug fix warrants, this table is the lower-cost mitigation the audit
// report calls out explicitly: failed fire-and-forget work records
// itself here instead of only a log line, so an admin/ops process can
// query "what silently failed and still needs attention" and,
// eventually, retry it. Deliberately generic (taskType + a JSON
// payload) rather than one table per failure kind, since the shape of
// "what do I need to retry this" varies by task and would otherwise
// mean a new table per fire-and-forget call site.
model FailedBackgroundTask {
  id           String    @id @default(cuid())
  taskType     String
  // Enough to actually retry the operation later — e.g. { adId, userId,
  // title, description, city, price, categoryId } for a failed
  // FRAUD_SCORE_AD, or { adId, title } for a failed
  // FAVORITED_AD_PRICE_CHANGED fan-out. Shape varies by taskType, same
  // "consumer switches on type first" convention as AuditLog.details /
  // FraudSignal.metadata elsewhere in this schema.
  payload      Json
  errorMessage String
  resolved     Boolean   @default(false)
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([taskType, resolved, createdAt])
  @@map("failed_background_tasks")
}

enum NotificationType {
  NEW_MESSAGE
  FAV_AD_PRICE_CHANGED
  // Gap #15: fires when an ad a user favorited transitions to SOLD —
  // see ads.service.ts's updateAd (the same justSold block that already
  // handles the SellerProfile stat bump) and notifications.service.ts's
  // onFavoritedAdSold.
  FAV_AD_SOLD
  PROMOTION
  WEEKLY_AD_VIEWS_REPORT
  WEEKLY_STORE_VIEWS_REPORT
  WEEKLY_SERVICE_VIEWS_REPORT
  SAVED_SEARCH_MATCH
  STORE_NEW_PRODUCT
  // PROMO-1 (Phase 14): lifecycle notification for a store owner's own
  // Promotion (backend/src/modules/promotions) — started, about to
  // expire, or expired. Deliberately separate from PROMOTION above
  // (that one is the admin-broadcast marketplace newsletter, see
  // notifications.service.ts's broadcastPromotion) — different
  // audience and trigger, see users.validation.ts's myPromotions
  // preference key for the full reasoning. `data` on this row's
  // Notification always includes { promotionId, productId, event }
  // where event is one of "started" | "expiring" | "expired", so the
  // frontend can render one shared component for all three instead of
  // three near-identical ones.
  PROMOTION_STATUS_CHANGE
  // STORE-FOLLOWER-NOTIFICATIONS (Foundation v1): distinct from
  // PROMOTION_STATUS_CHANGE above for the same reason that one is
  // distinct from PROMOTION — different audience (every follower of
  // the store, not the store owner) and a different trigger (fired
  // once, on the SCHEDULED -> ACTIVE transition only, from the same
  // myPromotionsExpiring.ts sweep that already detects that
  // transition for the owner-facing notification — no second sweep
  // needed). `data` always includes { promotionId, productId, storeId }.
  STORE_PROMOTION_STARTED
  // STORE-FOLLOWER-NOTIFICATIONS (Foundation v1): fired from
  // products.service.ts's updateProduct on an OUT_OF_STOCK -> (IN_STOCK
  // | LIMITED) transition, to every follower of the product's store.
  // Scoped to store followers rather than a per-product wishlist —
  // there is no Wishlist model in this schema yet (see the stores
  // gap-analysis roadmap's "Store Wishlist + Price Alerts", P2,
  // deferred). `data` always includes { productId, storeId }.
  STORE_PRODUCT_RESTOCKED
  // SERVICE REQUEST MARKETPLACE: fired to the customer when a provider
  // submits a quote on their open broadcast, and to the provider whose
  // quote gets accepted — see service-broadcasts.service.ts's
  // submitQuote/acceptQuote. `data` always includes { broadcastId,
  // quoteId }.
  NEW_SERVICE_QUOTE
  SERVICE_QUOTE_ACCEPTED
  // Open Requests marketplace (Request / RequestOffer)
  NEW_REQUEST_OFFER
  REQUEST_OFFER_ACCEPTED
  // FIX (audit #21): store-members.service.ts's inviteMember has fired
  // AuditEventType.STORE_MEMBER_INVITED (audit log) since 20260905120000
  // but had no matching NotificationType, so the invited user was never
  // actually notified — see notifications.service.ts's
  // onStoreMemberInvited. `data` always includes { storeId, memberId,
  // storeName }. Reuses the existing `storeUpdates` preference key
  // rather than adding a new one, consistent with other store-scoped
  // notifications above (STORE_NEW_PRODUCT etc.).
  STORE_MEMBER_INVITED
  // SERVICE-REQUEST-NOTIFICATIONS: the ServiceRequest lifecycle
  // (provider: new request / customer cancelled; customer: accepted /
  // rejected / in progress / completed / provider cancelled) and
  // appointment booked/cancelled for a customer's request. Reuse the
  // existing `serviceQuotes` preference key. `data` always includes
  // { requestId }; SERVICE_REQUEST_UPDATE also carries { status }.
  SERVICE_REQUEST_NEW
  SERVICE_REQUEST_UPDATE
  APPOINTMENT_UPDATE
}

