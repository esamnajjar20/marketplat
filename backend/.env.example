# Server
PORT=5000
NODE_ENV=development
# FIX INTEG-03: used to build the password-reset link sent by email
# (emailService.ts). Must be the real production frontend origin in
# production — left at localhost, every password reset email sent in
# prod would link users back to their own machine instead of the live site.
FRONTEND_URL=http://localhost:3000

# PROD-FIX-15: refreshToken moved from the JSON response body into an
# httpOnly cookie (see shared/utils/authCookies.ts).
# DEPLOY-FIX-01: this app is deployed with the frontend and backend on
# genuinely different registrable domains, so the refresh-token cookie
# uses sameSite:'none' (with secure:true, required by 'none') rather
# than 'lax' — 'lax'/'strict' are same-site-only and the browser would
# silently refuse to send the cookie back on cross-site /auth/refresh
# calls, logging every user out on their very next page load with no
# error surfaced anywhere. The one deliberate exception is the
# oauth_state cookie, which stays sameSite:'lax' since it only needs to
# survive a same-origin OAuth redirect round-trip. If this app is ever
# deployed with frontend and backend sharing a registrable domain
# (same host on different ports, or subdomains of the same domain),
# 'lax' would also work there and is the more conservative choice —
# see authCookies.ts's own comments before changing this.
# FRONTEND_URL above is also used for CORS's `origin` and must match the frontend's real
# origin regardless.

# Database
# FIX AUDIT-V3-02: without connection_limit, Prisma defaults to
# `num_physical_cpus * 2 + 1` connections — on a typical 2 vCPU
# container that's only 5 connections. Under any real concurrent load
# this exhausts the pool fast, surfacing as `P1001: Can't reach
# database server` or query timeouts that have nothing to do with the
# database actually being down. connection_limit=20 gives real headroom;
# pool_timeout=30 (seconds) makes a queued request wait briefly for a
# free connection instead of failing immediately when the pool is busy
# but not actually exhausted. Tune connection_limit against your actual
# Postgres max_connections and number of app instances — each instance
# gets its own pool of this size.
#
# FIX LOAD-01: this relationship (PM2 instances × connection_limit vs.
# Postgres max_connections) is no longer just a comment — server.ts
# calls checkConnectionCapacity() at boot (see
# src/shared/utils/capacityCheck.ts), which estimates the total and
# logs a warning if it looks likely to exhaust Postgres's configured
# max_connections (200 — see PROD-FIX-04 in docker-compose.yml, which
# raised this from Postgres's stock default of 100 for exactly this
# reason). Non-fatal — a deliberately tuned deployment (fixed
# PM2_INSTANCES, a differently-sized Postgres, PgBouncer, etc.) may
# legitimately exceed the heuristic — but it's now visible in the boot
# logs instead of silently relying on someone having read this comment.
DATABASE_URL=postgresql://user:password@localhost:5432/classifieds_db?connection_limit=20&pool_timeout=30

# Postgres container credentials (used by docker-compose.yml — production)
# DATABASE_URL above is composed from these when running via Docker Compose.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=classifieds_db

# FIX AUDIT-V3-02: used by docker-compose.yml/docker-compose.full.yml to
# build DATABASE_URL's connection_limit param (the DATABASE_URL line
# above is only used when running the app directly with `npm run dev`/
# `node dist/server.js`, not via Docker Compose, which constructs its
# own DATABASE_URL inline using these Postgres credentials).
DB_CONNECTION_LIMIT=20

# JWT
JWT_SECRET=your-super-secret-jwt-key-min-32-characters
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# FIX LOCAL-DEV-01: set to true only for providers that require TLS on
# every connection (Upstash and most managed Redis). Leave false (the
# default if unset) for a local/self-hosted Redis (docker-compose, or
# a native install under Termux/proot-distro) — forcing TLS against a
# plaintext local server hangs the connection until it times out.
REDIS_TLS=false

# Security
TRUST_PROXY=1
BLACKLIST_STRICT=true

# Cloudinary (required for image uploads)
# FIX PROD-AUDIT-01: previously this comment said "required" but
# nothing enforced it — env.ts's superRefine now actually fails
# startup when NODE_ENV=production and any of the three below is
# unset, same enforcement pattern as REDIS_PASSWORD above. Still
# optional in dev/test (no working upload service needed to run
# locally). ads.controller.ts's zero-image check on createAd was
# re-enabled alongside this — see TRACK-IMG-HOSTING there.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# FIX OAUTH-01: Google OAuth ("Continue with Google"). All three
# optional — completely unset by default, and the app works exactly as
# before with local email/password auth only when they're missing
# (see config/env.ts's googleOAuth.isConfigured / modules/auth/
# google.strategy.ts's configureGoogleStrategy, which logs a clear
# startup warning and skips registering the strategy in that case).
# GET /auth/google and /auth/google/callback both return a 503 with a
# GOOGLE_OAUTH_NOT_CONFIGURED code until all three are set — nothing
# else in the app is affected.
#
# To obtain these: console.cloud.google.com -> APIs & Services ->
# Credentials -> Create Credentials -> OAuth client ID -> Web
# application. Add GOOGLE_CALLBACK_URL below as an "Authorized redirect
# URI" there (must match exactly, including http/https and any path).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly equal an "Authorized redirect URI" configured on the
# Google Cloud Console credential above. Points at this backend's own
# callback route (note: /api/v1 prefix — see routes.ts), NOT the
# frontend. In production, use the real backend origin, e.g.
# https://api.your-domain.com/api/v1/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Observability (optional)
# FIX APM-02: real Sentry error tracking + performance tracing. Sign up
# at sentry.io, create a Node.js project, and paste its DSN below — the
# app starts and behaves identically without this set (see
# src/instrument.ts); this is purely opt-in.
SENTRY_DSN=
# Fraction of requests to trace (0.0-1.0). 0.1 = 10% — a reasonable
# starting point for production; tracing 100% of requests has a real
# cost (Sentry quota + a small per-request overhead). Irrelevant if
# SENTRY_DSN is unset.
SENTRY_TRACES_SAMPLE_RATE=0.1
# If set, every error-level log is ALSO POSTed as JSON to this URL —
# independent of SENTRY_DSN above; point it at a custom alerting
# endpoint, an internal Slack/PagerDuty bridge, or similar if you want a
# second destination (or a Sentry alternative) without touching code.
# Unset by default; logging behavior is unchanged without it.
ERROR_REPORTER_WEBHOOK_URL=

# Email (required for password reset to actually reach users — without
# this, forgotPassword falls back to logging the token instead of
# emailing it, which is NOT sufficient for production).
# Works with any SMTP provider: Gmail, AWS SES, SendGrid, Resend,
# Mailgun, a self-hosted relay, etc. — set the standard SMTP fields below.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=سوق غزة

# Web Push / VAPID (optional — without these, push notifications are
# skipped and only logged; in-app notifications and email keep working
# normally). Generate a key pair with: npx web-push generate-vapid-keys
# The public half must ALSO be set as NEXT_PUBLIC_VAPID_PUBLIC_KEY in
# the frontend's env and must match VAPID_PUBLIC_KEY below exactly.
# VAPID_SUBJECT must be a mailto: or https: URL (spec requirement) —
# push services use it to contact you if a deployment misbehaves.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# NEW — native (Capacitor/Android/iOS) push via Firebase Cloud Messaging.
# Separate from the VAPID keys above (those are Web Push only).
# Firebase Console -> Project Settings -> Service Accounts -> Generate
# new private key. FIREBASE_PRIVATE_KEY must keep its \n sequences
# literal (escaped), exactly as the downloaded JSON has them.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Security alerts (optional). Separate from ERROR_REPORTER_WEBHOOK_URL —
# this is specifically for security events (account lockouts, detected
# refresh-token reuse), letting you route them to a different
# channel/team than generic application errors. Email notification to
# the affected user happens regardless (via SMTP above); this webhook is
# an additional ops/SIEM-facing channel.
SECURITY_ALERT_WEBHOOK_URL=

# PROD-FIX-03 (optional): if set, GET /metrics requires this exact
# value via `Authorization: Bearer <token>`. Unset by default — /metrics
# stays unauthenticated (matches /health, /ready), which is only safe
# if it's also restricted at the network level (reverse-proxy allowlist,
# firewall rule, private network) since no such restriction ships in
# this repo's docker-compose.yml. Set this OR add a network-level
# restriction before exposing this service on a public network.
METRICS_TOKEN=

# Redis (optional tuning)
# maxmemory-policy is `noeviction` in docker-compose.yml — every Redis
# key in this app carries an explicit TTL, so raise this if you see
# OOM-related write rejections under real traffic rather than switching
# back to an *-lru eviction policy (which would risk evicting sessions).
REDIS_MAXMEMORY=1gb

# Separate cache Redis (optional, FIX CACHE-REDIS-SPLIT-01)
# When REDIS_CACHE_HOST is set, the public SWR caches (home, ads/stores/products
# lists, generation tokens, keep-warm leader) use that instance instead of the
# primary one. Run it with --maxmemory-policy allkeys-lru: the primary keeps
# `noeviction` for sessions/rate limits, and a full cache can then no longer
# make hard invalidations (takedowns) fail. Port/password/username/TLS default
# to the primary REDIS_* values. docker-compose.yml already wires `redis-cache`.
REDIS_CACHE_HOST=
REDIS_CACHE_PORT=
REDIS_CACHE_PASSWORD=
REDIS_CACHE_USERNAME=
REDIS_CACHE_TLS=
REDIS_CACHE_MAXMEMORY=256mb

# Backups (optional tuning)
# Cron-style or @daily/@weekly schedule for the db_backup service in
# docker-compose.yml. See that file for the documented restore procedure.
BACKUP_SCHEDULE=@daily

# FIX BACKUP-03: off-host backup sync (optional — disabled unless
# BACKUP_OFFSITE_BUCKET is set). See docker-compose.yml's
# db_backup_offsite_sync service for the full rationale: local-only
# backups don't survive a full host/disk loss, only in-place
# corruption. Works with real AWS S3 or any S3-compatible provider.
BACKUP_OFFSITE_BUCKET=
BACKUP_OFFSITE_ACCESS_KEY_ID=
BACKUP_OFFSITE_SECRET_ACCESS_KEY=
# Leave unset for real AWS S3. Set for an S3-compatible provider, e.g.:
#   Cloudflare R2:        https://<account-id>.r2.cloudflarestorage.com
#   Backblaze B2:          https://s3.<region>.backblazeb2.com
#   DigitalOcean Spaces:   https://<region>.digitaloceanspaces.com
#   Self-hosted MinIO:     http://minio:9000 (or your actual host:port)
BACKUP_OFFSITE_ENDPOINT_URL=
BACKUP_OFFSITE_REGION=us-east-1
# How often the sidecar re-syncs, in seconds. Default 21600 = 6 hours —
# frequent enough that an off-host copy of a recent backup always
# exists soon after db_backup's own @daily run, without syncing on
# every single check (aws s3 sync is already incremental/cheap for
# unchanged files, but there's no reason to poll more often than the
# underlying backup schedule actually produces new files).
BACKUP_OFFSITE_SYNC_INTERVAL_SECONDS=21600

# Ads (optional tuning)
# Maximum number of ACTIVE ads a single user may have at once. Prevents
# unbounded listing spam from a single account. SOLD/DELETED ads don't
# count against this — a user can always free a slot by closing an old
# listing. Defaults to 50 if unset.
MAX_ADS_PER_USER=50

# AUDIT-FIX 1.1: TTL (seconds) for the Redis image-operation lock used by
# addImages/removeImage on ads, products, and service listings. Default (30)
# is generous enough to cover multi-file Cloudinary upload latency; raise it
# only if deployments regularly see AdImagesLockedError/EntityImagesLockedError
# under normal (non-concurrent-abuse) traffic.
IMAGE_LOCK_TTL_SECONDS=30

# Fraud detection (item 12, optional tuning)
# Rolling window + threshold for the RAPID_POSTING signal: more than
# FRAUD_RAPID_POSTING_MAX_POSTS ad creations by the same user within
# FRAUD_RAPID_POSTING_WINDOW_SECONDS trips the signal.
FRAUD_RAPID_POSTING_WINDOW_SECONDS=60
FRAUD_RAPID_POSTING_MAX_POSTS=5
# Accounts younger than this are treated as "new" for the
# NEW_ACCOUNT_HIGH_ACTIVITY weighting bump.
FRAUD_NEW_ACCOUNT_WINDOW_HOURS=24
# Ad riskScore (0-100) at or above this auto-sets flaggedForReview,
# surfacing the ad in the admin fraud queue (GET /admin/fraud/ads).
FRAUD_AUTO_FLAG_THRESHOLD=60

# AUDIT-FIX 1.3: statement_timeout (ms) applied to the analytics
# dashboard's raw aggregate queries (trend/topCategories) only, via a
# short SET LOCAL transaction — does not affect any other query in the
# app. Raise it if legitimate wide-range reports start timing out.
ANALYTICS_QUERY_TIMEOUT_MS=10000
# Raw analytics retention; dashboard currently supports up to 90 days.
ANALYTICS_RETENTION_DAYS=90

# PROD-FIX-09 (optional, only matters for multi-replica deployments):
# docker-entrypoint.sh runs `prisma migrate deploy` on every container
# boot by default (RUN_MIGRATIONS_ON_BOOT=true). Safe for a single
# container (this repo's own compose files), and Prisma's advisory lock
# prevents corruption even with multiple containers — but at N replicas,
# every replica re-running this on every restart adds N-1 redundant
# waits on that lock to every rolling deploy. Set to "false" if you're
# running multiple replicas AND you've moved `prisma migrate deploy`
# into its own one-shot deploy step (CI/CD pipeline stage, Kubernetes
# Job/initContainer) that runs once before replicas roll out.
RUN_MIGRATIONS_ON_BOOT=true

# ── Email verification gating (T590) ──────────────────────────────────
# When true, authenticated write actions (posting ads/products/service
# listings, leaving reviews, ...) require a verified email address.
# Defaults to false because Google OAuth consent is still in Testing
# mode and Resend is still in its sandbox — with the gate on, real
# users would be blocked from every write. Set to 'true' after
# verifying the sender (see RESEND_API_KEY / GMAIL_USER notes above).
EMAIL_VERIFICATION_GATING=false

# ── CORS extra origins (T530-app) ─────────────────────────────────────
# Comma-separated list of additional origins allowed by CORS, on top
# of FRONTEND_URL. Useful for preview/staging deployments hosted on a
# different domain. Blank by default.
# CORS_EXTRA_ORIGINS=https://preview.example.com,https://staging.example.com

# ── Auth cookie policy (COOKIE-POLICY-01) ──────────────────────────
# Leave COOKIE_DOMAIN empty on Public Suffix hosts (*.up.railway.app).
# When frontend+backend share a real domain, set e.g. COOKIE_DOMAIN=.example.com
# and COOKIE_SAMESITE=lax (safer against CSRF than none).
COOKIE_DOMAIN=
COOKIE_SAMESITE=none

# ── FIX ENV-EXAMPLE-DRIFT-01 ─────────────────────────────────────
# Variables read by src/config/env.ts that were missing from this
# example file. A new developer cloning the repo would not have known
# they existed — including RESEND_API_KEY, which gates email
# verification and is on the launch checklist.

# Email — primary provider (Resend). Leave empty to fall back to Gmail OAuth.
RESEND_API_KEY=

# Email — Gmail OAuth fallback (used when RESEND_API_KEY is unset)
GMAIL_USER=
GOOGLE_REFRESH_TOKEN=

# CORS — extra allowed origins (comma-separated). Blank by default.
CORS_EXTRA_ORIGINS=

# Rate limiting — set to 'true' only in local dev to bypass all limits.
DISABLE_RATE_LIMIT=false
FORGOT_PASSWORD_RATE_LIMIT_MAX=

# Health-check response cache (ms). Blank uses the built-in default.
HEALTH_CACHE_DURATION_MS=

# Redis — optional username (only for ACL-enabled instances)
REDIS_USERNAME=

# Concurrency locks — TTL in seconds for the named resource locks.
SELLER_LOCK_TTL_SECONDS=
STORE_LOCK_TTL_SECONDS=
SERVICE_PROVIDER_LOCK_TTL_SECONDS=

# Business tuning
STALE_BOOST_DAYS=
FAILED_TASK_RETENTION_DAYS=

# Ops / scripts — dry-run mode for admin scripts
DRY_RUN=false

# ── Notifications pipeline (Phase 3) ─────────────────────────────────
# Queue-backed push delivery (retry/backoff), quiet-hours deferral and the
# opt-in unread-email fallback. OFF by default: nothing changes until set.
# Requires `npm install` (bullmq) and a PRIMARY Redis with
# maxmemory-policy noeviction + persistence (jobs live there).
NOTIFICATION_QUEUE_ENABLED=false
# Consume jobs inside this process (set false on web-only instances).
NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_QUEUE_CONCURRENCY=10
# Email fallback timing: check this long after a direct notification...
NOTIFICATION_EMAIL_FALLBACK_DELAY_MINUTES=30
# ...and send at most one digest per user per this window.
NOTIFICATION_EMAIL_FALLBACK_GAP_MINUTES=60
# SSE replay buffer (per connected user, on the cache Redis). 0 disables replay.
SSE_REPLAY_MAX_EVENTS=100
SSE_REPLAY_TTL_SECONDS=3600
