{
  "name": "@marketplat/cf-api-proxy",
  "version": "0.1.0",
  "private": true,
  "description": "Typed Cloudflare API gateway, edge-cache policy, and regression tests for MarketPlat",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p ../keepalive-worker/tsconfig.json",
    "test": "npm run build && node cache-policy.test.mts",
    "check": "npm run type-check && npm test",
    "audit:probe": "node cache-probe.mts",
    "prebuild": "node ../../tools/sync-cache-artifacts.mjs",
    "pretype-check": "node ../../tools/sync-cache-artifacts.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "dependencies": {
    "d1-namespace": "^1.1.1"
  }
}
