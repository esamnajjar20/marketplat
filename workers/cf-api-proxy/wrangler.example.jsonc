// مثال إعداد الـ Smart Gateway Worker (v8). انسخه إلى wrangler.jsonc وعدّل القيم.
{
  "name": "marketplat-api",
  "main": "worker.ts",
  "compatibility_date": "2026-11-04",
  // Native Workers Cache (outer cache, before Worker execution); Wrangler >= 4.69.0.
  "cache": { "enabled": true },

  // Required for browser clients: exact frontend origins, comma-separated.
  // Do not use a wildcard when credentials/cookies are enabled.
  "vars": { "FRONTEND_ORIGIN": "https://your-frontend-domain.example" },

  // Workers Cache is the outer cache and works on *.workers.dev. Cache API inside
  // worker.ts remains an optional per-colo layer; Cache-Tag purges use /__purge__.

  // #10 طبقة KV للتصنيفات (اختياري — بدونها يعمل الـ Worker كما هو):
  //   npx wrangler kv namespace create REFERENCE_KV
  "kv_namespaces": [{ "binding": "REFERENCE_KV", "id": "<KV_NAMESPACE_ID>" }],

  // قياس HIT ratio الحقيقي (اختياري) — Workers Analytics Engine:
  "analytics_engine_datasets": [{ "binding": "CACHE_METRICS", "dataset": "marketplat_cache" }],

  // Secret for POST /__purge__ (must match EDGE_WORKER_PURGE_TOKEN in Express):
  //   npx wrangler secret put PURGE_TOKEN
  // Express should set EDGE_WORKER_PURGE_URL to https://<worker-host>/__purge__;
  // JSON { tags: [...] } invalidates Workers Cache; empty body still flushes reference KV.

  // Shared backend health state across Worker isolates (SQLite-backed Durable Object).
  "durable_objects": {
    "bindings": [{ "name": "GATEWAY_HEALTH", "class_name": "GatewayHealthCoordinator" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GatewayHealthCoordinator"] }],

  // intentionally no Cron trigger: cache warm-up is disabled by project policy.
  // Add GATEWAY_ADMIN_TOKEN with: npx wrangler secret put GATEWAY_ADMIN_TOKEN
  // Add GO_WORKER_TOKEN with: npx wrangler secret put GO_WORKER_TOKEN (API-to-Gateway ingress secret).
  // Optional per-service upstream secrets: npx wrangler secret put GO_WORKER_TOKENS_JSON
  // JSON object keyed by serviceKey; if present, every service requires a 32+ char token.
  // If multiple logical keys use the current Go monolith, assign them the same token; distinct tokens
  // require separate Go processes, each configured with the matching GO_WORKER_TOKEN.
  // For multi-service routing, configure Express GO_WORKER_URL as https://<this-worker-host>/__go.
  // Optional GATEWAY_ALLOWED_HOSTS belongs in Worker vars, not in browser code.
  // For frontend routing, set FRONTEND_GATEWAY_HOSTS to exact public hostnames (comma-separated)
  // in Worker vars, then map each hostname/* Cloudflare Route to this same Worker.
  // The frontend origin itself must be a different host to avoid a proxy loop.
}
