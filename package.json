{
  "name": "marketplat-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "MarketPlat web, API, and mobile applications in a shared monorepo",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev:web": "npm --prefix frontend run dev",
    "dev:api": "pnpm --filter classifieds-platform-backend dev",
    "build:web": "npm --prefix frontend run build",
    "build:api": "pnpm --filter classifieds-platform-backend build",
    "test:web": "npm --prefix frontend run test",
    "test:api": "pnpm --filter classifieds-platform-backend test",
    "type-check:web": "npm --prefix frontend run type-check",
    "type-check:api": "pnpm --filter classifieds-platform-backend type-check",
    "lint:web": "npm --prefix frontend run lint",
    "lint:api": "pnpm --filter classifieds-platform-backend lint",
    "verify:workspace": "node tooling/verify-workspace.mjs",
    "test:contracts": "pnpm --filter @marketplat/contracts test",
    "type-check:contracts": "pnpm --filter @marketplat/contracts type-check",
    "dev:mobile": "pnpm --filter @marketplat/mobile dev",
    "android:mobile": "pnpm --filter @marketplat/mobile android",
    "ios:mobile": "pnpm --filter @marketplat/mobile ios",
    "type-check:mobile": "pnpm --filter @marketplat/mobile type-check",
    "test:mobile": "pnpm --filter @marketplat/mobile test",
    "build:apk:test": "pnpm --filter @marketplat/mobile build:apk:test",
    "verify:apk:test": "pnpm --filter @marketplat/mobile verify:apk:test",
    "build:all": "npm --prefix frontend run build && pnpm --filter classifieds-platform-backend build",
    "type-check:all": "npm --prefix frontend run type-check && pnpm --recursive --if-present run type-check",
    "test:all": "npm --prefix frontend run test && pnpm --recursive --if-present run test",
    "lint:all": "npm --prefix frontend run lint && pnpm --filter classifieds-platform-backend lint",
    "dev:all": "node tooling/dev-all.mjs",
    "test:worker": "pnpm --filter @marketplat/cf-api-proxy test",
    "type-check:worker": "pnpm --filter @marketplat/cf-api-proxy type-check",
    "check:worker": "pnpm --filter @marketplat/cf-api-proxy check",
    "audit:http-payload-phase4": "pnpm --filter classifieds-platform-backend audit:http-payload-phase4",
    "audit:db-query-phase5": "pnpm --filter classifieds-platform-backend audit:db-query-phase5",
    "audit:db-query-phase6": "pnpm --filter classifieds-platform-backend audit:db-query-phase6",
    "profile:db-queries": "pnpm --filter classifieds-platform-backend profile:db-queries",
    "audit:http-requests": "npm --prefix frontend run network:phase6-audit && pnpm --filter classifieds-platform-backend audit:http-payload-phase4 && pnpm --filter classifieds-platform-backend audit:db-query-phase5 && pnpm --filter classifieds-platform-backend audit:db-query-phase6",
    "simulator:install": "npm --prefix tools/user-simulator install",
    "simulator:browser:install": "npm --prefix tools/user-simulator run install:browser",
    "simulator:start": "npm --prefix tools/user-simulator start",
    "simulator:test": "npm --prefix tools/user-simulator test"
  },
  "pnpm": {
    "overrides": {
      "zod": "3.22.0"
    }
  }
}
