{
  "name": "marketplat-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "MarketPlat web, API, and mobile applications in a shared monorepo",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev:web": "pnpm --filter marketplat dev",
    "dev:api": "pnpm --filter classifieds-platform-backend dev",
    "build:web": "pnpm --filter marketplat build",
    "build:api": "pnpm --filter classifieds-platform-backend build",
    "test:web": "pnpm --filter marketplat test",
    "test:api": "pnpm --filter classifieds-platform-backend test",
    "type-check:web": "pnpm --filter marketplat type-check",
    "type-check:api": "pnpm --filter classifieds-platform-backend type-check",
    "lint:web": "pnpm --filter marketplat lint",
    "lint:api": "pnpm --filter classifieds-platform-backend lint",
    "verify:workspace": "node tooling/verify-workspace.mjs",
    "test:contracts": "pnpm --filter @marketplat/contracts test",
    "type-check:contracts": "pnpm --filter @marketplat/contracts type-check",
    "dev:mobile": "pnpm --filter @marketplat/mobile dev",
    "android:mobile": "pnpm --filter @marketplat/mobile android",
    "ios:mobile": "pnpm --filter @marketplat/mobile ios",
    "type-check:mobile": "pnpm --filter @marketplat/mobile type-check",
    "test:mobile": "pnpm --filter @marketplat/mobile test",
    "build:all": "turbo run build --filter=marketplat --filter=classifieds-platform-backend",
    "type-check:all": "turbo run type-check --filter=marketplat --filter=classifieds-platform-backend --filter=@marketplat/mobile --filter=@marketplat/contracts --filter=@marketplat/cf-api-proxy",
    "test:all": "turbo run test --filter=marketplat --filter=classifieds-platform-backend --filter=@marketplat/mobile --filter=@marketplat/contracts",
    "lint:all": "turbo run lint --filter=marketplat --filter=classifieds-platform-backend",
    "dev:all": "turbo run dev --filter=marketplat --filter=classifieds-platform-backend --filter=@marketplat/mobile",
    "test:worker": "pnpm --filter @marketplat/cf-api-proxy test",
    "verify:prisma-layout": "node tooling/verify-prisma-layout.mjs"
  },
  "devDependencies": {
    "turbo": "^2.5.8"
  }
}
