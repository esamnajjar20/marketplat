{
  "expo": {
    "name": "MarketPlat",
    "slug": "marketplat-mobile",
    "scheme": "marketplat",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "اسمح لـ MarketPlat بالوصول إلى صورك لإرفاقها بإعلاناتك.",
          "cameraPermission": "اسمح لـ MarketPlat باستخدام الكاميرا لالتقاط صور للإعلانات."
        }
      ],
      [
        "expo-sqlite",
        { "useSQLCipher": true }
      ],
      "expo-secure-store",
      "expo-splash-screen",
      [
        "expo-audio",
        {
          "microphonePermission": "اسمح لـ MarketPlat بتسجيل رسالة صوتية ترسلها داخل المحادثة."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "useLegacyPackaging": false
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.marketplat.mobile",
      "supportsRTL": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FBF6EE"
      },
      "versionCode": 1
    },
    "ios": {
      "bundleIdentifier": "com.marketplat.mobile",
      "supportsTablet": true
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FBF6EE"
    }
  }
}
