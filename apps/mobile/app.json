{
  "expo": {
    "name": "MarketPlat",
    "slug": "marketplat-mobile",
    "scheme": "marketplat",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "\u0627\u0633\u0645\u062d \u0644\u0640 MarketPlat \u0628\u0627\u0644\u0648\u0635\u0648\u0644 \u0625\u0644\u0649 \u0635\u0648\u0631\u0643 \u0644\u0625\u0631\u0641\u0627\u0642\u0647\u0627 \u0628\u0625\u0639\u0644\u0627\u0646\u0627\u062a\u0643.",
          "cameraPermission": "\u0627\u0633\u0645\u062d \u0644\u0640 MarketPlat \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0643\u0627\u0645\u064a\u0631\u0627 \u0644\u0627\u0644\u062a\u0642\u0627\u0637 \u0635\u0648\u0631 \u0644\u0644\u0625\u0639\u0644\u0627\u0646\u0627\u062a."
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-splash-screen",
      [
        "expo-audio",
        {
          "microphonePermission": "\u0627\u0633\u0645\u062d \u0644\u0640 MarketPlat \u0628\u062a\u0633\u062c\u064a\u0644 \u0631\u0633\u0627\u0644\u0629 \u0635\u0648\u062a\u064a\u0629 \u062a\u0631\u0633\u0644\u0647\u0627 \u062f\u0627\u062e\u0644 \u0627\u0644\u0645\u062d\u0627\u062f\u062b\u0629."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.marketplat.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7F8FA"
      },
      "versionCode": 1
    },
    "ios": {
      "bundleIdentifier": "com.marketplat.mobile",
      "supportsTablet": true
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F8FA"
    }
  }
}
