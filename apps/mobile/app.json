{
  "expo": {
    "name": "MarketPlat",
    "slug": "marketplat-mobile",
    "scheme": "marketplat",
    "version": "0.1.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "اسمح لـ MarketPlat بالوصول إلى صورك لإرفاقها بإعلاناتك.",
          "cameraPermission": false
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-secure-store",
      "expo-splash-screen",
      [
        "expo-audio",
        {
          "microphonePermission": "اسمح لـ MarketPlat بتسجيل رسالة صوتية ترسلها داخل المحادثة."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "useLegacyPackaging": false
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "./plugins/with-secure-storage-backup",
      "./plugins/with-forced-rtl"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.marketplat.mobile",
      "supportsRTL": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FDFCF9"
      },
      "versionCode": 2,
      "blockedPermissions": [
        "android.permission.VIBRATE"
      ],
      "allowBackup": false
    },
    "ios": {
      "bundleIdentifier": "com.marketplat.mobile",
      "supportsTablet": true
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FDFCF9"
    }
  }
}
