{
  "name": "@marketplat/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "type-check": "tsc --noEmit",
    "test": "node ./scripts/run-all-verifications.mjs",
    "build:apk:test": "cd android && ./gradlew assembleRelease",
    "verify:apk:test": "node ./scripts/verify-release-config.mjs",
    "test:storage": "node --test src/storage/__tests__/*.test.mjs",
    "test:sqlite": "vitest run",
    "verify:phase2": "node ./scripts/verify-phase2-build-config.mjs"
  },
  "dependencies": {
    "@expo/dom-webview": "~58.0.2",
    "@react-native-community/netinfo": "^12.0.1",
    "expo": "~58.0.19",
    "expo-audio": "~58.0.9",
    "expo-build-properties": "~0.14.0",
    "expo-constants": "~58.0.13",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.11",
    "expo-image": "~58.0.8",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~5.7.0",
    "vitest": "^2.1.9"
  }
}
