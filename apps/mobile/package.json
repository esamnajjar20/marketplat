{
  "name": "@marketplat/mobile",
  "version": "0.1.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "build:apk:test": "cd android && ./gradlew assembleDebug",
    "verify:apk:test": "node ./scripts/verify-release-config.mjs",
    "test:storage": "node --test src/storage/__tests__/*.test.mjs",
    "test:sqlite": "vitest run",
    "verify:phase2": "node ./scripts/verify-phase2-build-config.mjs",
    "test:all": "pnpm run test && pnpm run test:storage && pnpm run verify:static",
    "lint": "eslint \"app/**/*.{ts,tsx}\" \"src/**/*.{ts,tsx}\" --max-warnings=0 && node ./scripts/lint-mobile.mjs",
    "verify:production-signing": "cd android && ./gradlew :app:verifyProductionSigning",
    "verify:a11y": "node ./scripts/verify-design-system-a11y.mjs",
    "verify:navigation-policy": "node ./scripts/verify-navigation-policy.mjs",
    "verify:phase4": "node ./scripts/verify-phase4-offline-security.mjs",
    "verify:static": "node ./scripts/run-all-verifications.mjs",
    "test:coverage": "vitest run --coverage",
    "verify:theme": "node ./scripts/verify-theme-system.mjs",
    "verify:workspace-unification": "node ./scripts/verify-workspace-unification.mjs",
    "format": "prettier --write \"app/**/*.{ts,tsx}\" \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"app/**/*.{ts,tsx}\" \"src/**/*.{ts,tsx}\"",
    "report:tokens": "node ./scripts/report-token-bypass.mjs",
    "analyze:bundle": "node ./scripts/analyze-bundle.mjs"
  },
  "dependencies": {
    "@expo/dom-webview": "~58.0.2",
    "@react-native-community/netinfo": "^12.0.1",
    "@sentry/react-native": "~8.28.0",
    "@shopify/flash-list": "^2.0.2",
    "expo": "~58.0.19",
    "expo-audio": "~58.0.9",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.11",
    "expo-image": "~58.0.8",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.0",
    "zod": "3.22.0"
  },
  "devDependencies": {
    "@expo/config-plugins": "~58.0.12",
    "@types/react": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitest/coverage-v8": "2.1.9",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.3.3",
    "typescript": "~6.0.3",
    "vitest": "^2.1.9"
  }
}
