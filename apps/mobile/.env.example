# Set this to the reachable API origin (do not include /api/v1; the app adds the route).
# Android emulator usually reaches a host machine via http://10.0.2.2:<port>.
# A physical phone needs your computer's LAN IP or a reachable HTTPS endpoint.
EXPO_PUBLIC_API_URL=https://your-api-host.example

# Optional. When set and @sentry/react-native is installed, crashes are reported.
# Leave empty for local-only logging. See docs/mobile/checklists/SENTRY-SETUP.md
EXPO_PUBLIC_SENTRY_DSN=

# Public web origin used by legal and informational links (origin only).
EXPO_PUBLIC_WEB_URL=https://your-web-host.example

# Sentry release/source-map upload variables are configured in EAS/CI, not EXPO_PUBLIC.
# Keep the auth token secret; never put it in a client-side env variable.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_URL=https://sentry.io/

# Place the Firebase Android config at apps/mobile/google-services.json (gitignored).
# Native remote push requires a development/production build, not Expo Go.
# Backend FIREBASE_PROJECT_ID must match this Firebase app's project; install
# FIREBASE_CLIENT_EMAIL / FIREBASE_PRIVATE_KEY on API (and Go when enabled).
