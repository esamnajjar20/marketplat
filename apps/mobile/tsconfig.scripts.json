{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [
      "node"
    ],
    "typeRoots": [
      "../../frontend/node_modules/@types",
      "../../apps/api/node_modules/@types"
    ]
  },
  "include": [
    "scripts/**/*.mts",
    "scripts/**/*.cts",
    "src/**/*.mts",
    "src/**/*.cts"
  ],
  "exclude": [
    "node_modules",
    "android",
    ".expo",
    "assets",
    "dist",
    "build"
  ]
}
