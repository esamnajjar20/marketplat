{
  "name": "marketplat",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "keep_names": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/_next/static/*"
    ]
  },
  "services": [
    {
      "binding": "API_WORKER",
      "service": "marketplat-api"
    },
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "marketplat"
    }
  ],
  "alias": {
    "sharp": "./stubs/sharp-stub.js",
    "@img/sharp-linux-x64": "./stubs/sharp-stub.js",
    "@img/sharp-linuxmusl-x64": "./stubs/sharp-stub.js",
    "@img/sharp-linux-arm64": "./stubs/sharp-stub.js",
    "@img/sharp-linux-arm": "./stubs/sharp-stub.js",
    "@img/sharp-darwin-arm64": "./stubs/sharp-stub.js",
    "@img/sharp-darwin-x64": "./stubs/sharp-stub.js",
    "@img/sharp-win32-x64": "./stubs/sharp-stub.js",
    "@img/sharp-win32-ia32": "./stubs/sharp-stub.js",
    "@img/sharp-win32-arm64": "./stubs/sharp-stub.js"
  }
}
