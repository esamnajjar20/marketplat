<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press app icon shortcuts (Android 7.1+). Paths match Next routes via deep link scheme. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="search"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_search_short"
        android:shortcutLongLabel="@string/shortcut_search_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.marketplat.app"
            android:targetClass="com.marketplat.app.MainActivity"
            android:data="marketplat://search" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>

    <shortcut
        android:shortcutId="create_ad"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_create_short"
        android:shortcutLongLabel="@string/shortcut_create_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.marketplat.app"
            android:targetClass="com.marketplat.app.MainActivity"
            android:data="marketplat://ads/create" />
    </shortcut>

    <shortcut
        android:shortcutId="messages"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_messages_short"
        android:shortcutLongLabel="@string/shortcut_messages_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.marketplat.app"
            android:targetClass="com.marketplat.app.MainActivity"
            android:data="marketplat://messages" />
    </shortcut>
</shortcuts>
