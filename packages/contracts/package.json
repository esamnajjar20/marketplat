{
  "name": "@marketplat/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Shared runtime validation schemas and API contracts for MarketPlat apps",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit -p tsconfig.json && pnpm run build",
    "test": "node --experimental-strip-types --test test/*.test.mts",
    "pretest": "pnpm run build"
  },
  "dependencies": {
    "zod": "3.25.76"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ]
}
