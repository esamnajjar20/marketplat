{
  "compilerOptions": {
    // FIX TS-01: ES2022 instead of ES2017.
    //   ES2017 forces the compiler to polyfill async/await into generators,
    //   bloating the output. Next.js 15 targets modern runtimes (Node 18+,
    //   evergreen browsers via Babel/SWC) — ES2022 is appropriate and aligns
    //   with what Next.js uses internally.
    "target": "ES2022",

    "lib":    ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,

    // ── Strict mode ───────────────────────────────────────────────
    "strict": true,
    // FIX TS-02: noUncheckedIndexedAccess catches arr[i] → T | undefined.
    //   Particularly important for TanStack Query result arrays and
    //   searchParams property access.
    "noUncheckedIndexedAccess": true,
    // FIX TS-03: Catch unused locals/parameters at compile time,
    //   not just via ESLint (faster feedback loop).
    "noUnusedLocals":     true,
    "noUnusedParameters": true,
    // Prevent accidental fall-through in switch statements.
    "noFallthroughCasesInSwitch": true,

    "noEmit":            true,
    "esModuleInterop":   true,
    "module":            "esnext",
    "moduleResolution":  "bundler",
    "resolveJsonModule": true,
    "isolatedModules":   true,
    "jsx":               "preserve",

    // FIX TS-04: Explicit tsBuildInfoFile location keeps incremental
    //   artifacts out of the project root.
    "incremental":     true,
    "tsBuildInfoFile": ".next/cache/tsconfig.tsbuildinfo",

    "plugins": [{ "name": "next" }],

    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "__tests__",
    "e2e"
  ]
}
