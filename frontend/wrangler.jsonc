// Configure the same server-only GATEWAY_ADMIN_TOKEN secret used by the API Worker
// via: npx wrangler secret put GATEWAY_ADMIN_TOKEN. Never use NEXT_PUBLIC_.
{
  "name": "marketplat",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "keep_names": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": ["/*", "!/_next/static/*"]
  },
  "services": [
    {
      "binding": "API_WORKER",
      "service": "marketplat-api"
    },
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "marketplat"
    }
  ]
}
