// Configure server-only secrets for admin proxy routes. Never use NEXT_PUBLIC_.
// Feature flags are managed by SUPER_ADMIN through this frontend Worker; the
// same 32+ character FEATURE_FLAGS_ADMIN_TOKEN must be set on both Workers.
// Run `npx wrangler secret put FEATURE_FLAGS_ADMIN_TOKEN` from this folder too.
// The secret is forwarded only over the API_WORKER Service Binding.
{
  "name": "marketplat",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "keep_names": false,
  "images": {
    "binding": "IMAGES"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": ["/*", "!/_next/static/*"]
  },
  // Create with: npx wrangler kv namespace create NEXT_INC_CACHE_KV
  // Replace the placeholder with the returned 32-character namespace ID before deploy.
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "aa4ca4859c924617954a7752d4fc4c80",
      "remote": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler"
      },
      {
        "name": "NEXT_TAG_CACHE_DO_SHARDED",
        "class_name": "DOShardedTagCache"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "DOQueueHandler",
        "DOShardedTagCache"
      ]
    }
  ],
  "services": [
    {
      "binding": "API_WORKER",
      "service": "marketplat-api"
    },
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "marketplat"
    }
  ]
}
