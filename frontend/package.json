{
  "name": "marketplat",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/generate-warming-manifest.mjs && next build --webpack && node scripts/generate-warming-manifest.mjs",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "type-check:e2e": "tsc --noEmit -p e2e/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "e2e:codegen": "playwright codegen http://localhost:3000",
    "tessdata:sync": "node scripts/sync-tessdata.mjs",
    "postinstall": "node scripts/sync-tessdata.mjs || true",
    "cap:sync": "npx cap sync",
    "cap:android": "npx cap add android",
    "cap:open:android": "npx cap open android",
    "cap:run:android": "npx cap run android",
    "cache:contract-audit": "node scripts/cache-contract-audit.mjs",
    "cache:performance-audit": "node scripts/cache-performance-audit.mjs",
    "cache:final-audit": "node scripts/cache-final-audit.mjs",
    "warming:audit": "node scripts/warming-final-audit.mjs",
    "perf:render-audit": "node scripts/render-audit.mjs",
    "perf:render-regression": "node scripts/render-regression-audit.mjs",
    "perf:query-invalidation-audit": "node scripts/query-invalidation-audit.mjs",
    "hydration:regression-audit": "node scripts/hydration-regression-audit.mjs && node scripts/render-regression-audit.mjs",
    "perf:virtualization-audit": "node scripts/virtualization-audit.mjs",
    "offline:ux-audit": "node scripts/offline-ux-phases-3-4-audit.mjs",
    "offline:ux-phases-5-6-audit": "node scripts/offline-ux-phases-5-6-audit.mjs",
    "offline:inventory": "node scripts/offline-system-inventory.mjs --write",
    "offline:phase1-audit": "node scripts/offline-system-inventory.mjs --write && node --test scripts/offline-phase1-guardrails.test.mjs",
    "offline:phase2-audit": "node scripts/offline-phase12-audit.mjs",
    "offline:phase3-audit": "node scripts/offline-phase3-storage-audit.mjs",
    "offline:phase4-audit": "node scripts/offline-system-inventory.mjs --write && node --test scripts/offline-phase1-guardrails.test.mjs && node scripts/offline-phase12-audit.mjs && node scripts/offline-phase3-storage-audit.mjs && node scripts/offline-phase4-lifecycle-audit.mjs && node --check public/sw.js",
    "offline:phase5-audit": "node scripts/offline-phase5-queue-audit.mjs && node --check public/sw.js && node scripts/offline-phase4-lifecycle-audit.mjs && node scripts/offline-phase3-storage-audit.mjs && node scripts/offline-phase12-audit.mjs && node --test scripts/offline-phase1-guardrails.test.mjs",
    "offline:phase6-audit": "node scripts/offline-phase6-ux-audit.mjs && node scripts/offline-phase5-queue-audit.mjs && node --check public/sw.js && node scripts/offline-phase4-lifecycle-audit.mjs && node scripts/offline-phase3-storage-audit.mjs && node scripts/offline-phase12-audit.mjs && node --test scripts/offline-phase1-guardrails.test.mjs",
    "offline:phase7-audit": "node scripts/offline-phase7-warming-audit.mjs && node scripts/offline-phase6-ux-audit.mjs && node scripts/offline-phase5-queue-audit.mjs && node --check public/sw.js && node scripts/offline-phase4-lifecycle-audit.mjs && node scripts/offline-phase3-storage-audit.mjs && node scripts/offline-phase12-audit.mjs && node --test scripts/offline-phase1-guardrails.test.mjs",
    "offline:phase8-audit": "node scripts/offline-system-inventory.mjs --write && node scripts/offline-phase8-integration-audit.mjs && node scripts/offline-phase7-warming-audit.mjs && node scripts/offline-phase6-ux-audit.mjs && node scripts/offline-phase5-queue-audit.mjs && node --check public/sw.js && node scripts/offline-phase4-lifecycle-audit.mjs && node scripts/offline-phase3-storage-audit.mjs && node scripts/offline-phase12-audit.mjs && node --test scripts/offline-phase1-guardrails.test.mjs",
    "offline:phase8-test": "playwright test e2e/tests/offline-phase8.integration.spec.ts",
    "device-errors:audit": "node scripts/device-error-monitor-audit.mjs",
    "hydration:offline-cache-audit": "node scripts/hydration-offline-cache-audit.mjs",
    "network:request-audit": "node scripts/network-request-monitor-audit.mjs",
    "query-keys:audit": "node scripts/query-key-audit.cjs && node scripts/query-invalidation-factory-audit.cjs && node scripts/query-key-types-audit.cjs",
    "query-keys:types-audit": "node scripts/query-key-types-audit.cjs",
    "query-keys:verify": "npm run query-keys:audit && vitest run __tests__/integration/queryKeys.test.ts __tests__/integration/queryOptions.test.ts __tests__/integration/queryKeyCacheSemantics.test.ts __tests__/integration/queryInvalidationSemantics.test.ts",
    "offline:cache-truth-audit": "node scripts/offline-cache-truth-audit.mjs && node --check public/sw.js",
    "offline:pinned-shells-audit": "node scripts/offline-pinned-shells-audit.mjs && node --check public/sw.js",
    "offline:mutation-policy-audit": "node scripts/offline-mutation-policy-audit.mjs && node --check public/sw.js"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/camera": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/geolocation": "^7.0.0",
    "@capacitor/ios": "^7.6.9",
    "@capacitor/preferences": "^7.0.0",
    "@capacitor/push-notifications": "^7.0.0",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0",
    "@fontsource/cairo": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@hookform/resolvers": "^3.9.0",
    "@opennextjs/cloudflare": "^1.5.0",
    "@radix-ui/react-avatar": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@tanstack/react-query": "^5.0.0",
    "@tanstack/react-query-devtools": "^5.0.0",
    "@tanstack/react-table": "^8.21.3",
    "axios": "^1.7.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.511.0",
    "next": "^16.3.1",
    "next-themes": "^0.4.4",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.53.0",
    "react-leaflet": "^5.0.0",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.3.0",
    "tesseract.js": "^5.1.1",
    "zod": "^3.25.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@playwright/test": "^1.48.0",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.0",
    "eruda": "^3.4.3",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.1",
    "jsdom": "^25.0.0",
    "msw": "^2.4.0",
    "postcss": "^8.4.0",
    "prettier": "^3.3.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.6.0",
    "vitest": "^2.1.9"
  }
}
