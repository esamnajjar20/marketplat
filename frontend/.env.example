# Backend API origin (no trailing slash, no /api/v1 — that's appended
# automatically by lib/constants.ts's API_BASE_URL). Used by the axios
# client (api/client.ts), middleware.ts's CSP/CORS-adjacent checks, and
# GoogleAuthButton.tsx's full-page redirect to GET /auth/google.
NEXT_PUBLIC_API_URL=http://localhost:5000

# NEW — used by capacitor.config.ts (read at `npx cap sync` time, Node
# side, not bundled into the browser) as the origin the Android/iOS
# shell loads. Set this to your deployed frontend URL (Railway/Vercel),
# e.g. https://marketplat.app. Also used by lib/constants.ts's APP_URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# FIX OAUTH-01: purely a UI flag — controls whether the "Continue with
# Google" button (components/auth/GoogleAuthButton.tsx) renders on the
# Login and Register pages. Same on/off pattern as
# NEXT_PUBLIC_VAPID_PUBLIC_KEY below for push notifications: a
# build-time env var, baked in at `next build` time (changing it
# requires a rebuild, not just a restart).
#
# This must be kept in sync with whether the BACKEND actually has
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET / GOOGLE_CALLBACK_URL set
# (see backend/.env.example) — setting this to true here while the
# backend has no Google credentials configured would show a button
# that always fails with a 503. Any non-empty value enables it (the
# code only checks truthiness); "true" is the conventional value.
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=

# Push notifications (optional — see components/pwa/PushNotificationToggle.tsx
# and lib/pwa.ts). Must match the backend's VAPID key pair.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# FIX PWA-DEV-01: the Service Worker (public/sw.js) is intentionally NOT
# registered under `next dev` by default (lib/pwa.ts's registerServiceWorker) —
# HMR rewrites chunk URLs on every save, and a live SW intercepting fetches
# during that causes stale-chunk/caching bugs that don't reflect any real
# production issue. This was previously undocumented anywhere, so testing
# offline/PWA behavior locally silently did nothing and looked broken. Set
# to "true" to force-register the real SW under `next dev` (requires a
# `next build && next start` or a hard page reload after toggling, not just
# HMR, to take effect cleanly).
NEXT_PUBLIC_ENABLE_SW_DEV=

# Optional: public Android install link (Play Store or direct APK). When set,
# the homepage shows a small "download the app" card to web visitors; when
# empty the card is not rendered at all.
NEXT_PUBLIC_ANDROID_APP_URL=

# Support email shown on the public Contact page.
# REQUIRED for production builds; do not leave a placeholder address.
NEXT_PUBLIC_SUPPORT_EMAIL=
