{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": [
      "node",
      "@playwright/test"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler"
  },
  "include": [
    "./**/*.ts",
    "../playwright.config.ts"
  ],
  "exclude": [
    "../node_modules",
    "../.next",
    "../__tests__",
    "../out",
    "../build",
    "../dist"
  ]
}
