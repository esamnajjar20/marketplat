# Repository metadata and local dependency/build output
.git
.gitignore
**/node_modules
**/.next
**/dist
**/coverage
**/playwright-report
**/test-results
**/.turbo
**/.expo
**/android/.gradle
**/ios/Pods

# Local secrets and machine-specific files
.env
.env.*
!.env.example
**/*.log
.DS_Store

# Legacy duplicate trees are not part of the apps/* monorepo build

# Local npm lockfiles are not used by the pnpm workspace images
**/package-lock.json
