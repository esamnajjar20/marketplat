# Set a random secret with at least 32 characters. Keep it only on the runner and API server.
SIMULATOR_ADMIN_TOKEN=replace-with-a-random-secret-of-at-least-32-characters

# Published frontend origin. The runner rejects any host not in SIMULATOR_ALLOWED_HOSTS.
SIMULATOR_TARGET_URL=https://marketplat.esamnajjar6.workers.dev
SIMULATOR_ALLOWED_HOSTS=marketplat.esamnajjar6.workers.dev
SIMULATOR_PORT=8787
SIMULATOR_HOST=127.0.0.1
SIMULATOR_DATA_DIR=./data
SIMULATOR_REPORT_DIR=./reports
SIMULATOR_HARD_MAX_USERS=100
SIMULATOR_HARD_MAX_CONCURRENCY=20
SIMULATOR_HARD_MAX_WRITE_USERS=5
SIMULATOR_DEFAULT_TIMEOUT_MS=20000

# To create new accounts, use a real mailbox/domain you control. Example:
# SIMULATOR_EMAIL_TEMPLATE=qa+{runId}-{user}-{iteration}@your-domain.example
# SIMULATOR_TEST_PASSWORD=set-a-unique-test-password-here
# For login journeys, define one or more accounts as JSON. Passwords remain server-side.
# SIMULATOR_TEST_ACCOUNTS=[{"email":"buyer1@your-domain.example","password":"...","role":"buyer"},{"email":"seller1@your-domain.example","password":"...","role":"seller"}]

# Optional QA-owned records used by specific business-journey scenarios.
# These IDs must belong to the dedicated QA environment/accounts, not real customer data.
# SIMULATOR_SEED_AD_ID=qa-published-ad-id
# SIMULATOR_SEED_SELLER_ID=qa-seller-user-id
# SIMULATOR_SEED_PRODUCT_ID=qa-owned-product-id
# SIMULATOR_SEED_SERVICE_ID=qa-owned-service-id
